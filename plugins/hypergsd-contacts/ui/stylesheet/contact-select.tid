title: $:/plugins/yan/hypergsd-contacts/ui/stylesheet/contact-select

/* The multi-contact search cluster: the group-strip's spacing mechanism — flex + gap spaces the label, every picked contact, the picker and the Add button, because trim removes the inline whitespace and the host strip's gap cannot reach inside its single flex child. */
.hgsd-contact-select {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.3em 0.75em;
}

/* Each picked contact's entry (hgsd-contact-entry): the link-items shape — inline-flex + gap spaces the name from the × (the row-gap mechanism, because trim removes the inline whitespace and the entry is no gsd-list-item row). */
.hgsd-contact-entry {
  display: inline-flex;
  align-items: center;
  gap: 0.3em;
}