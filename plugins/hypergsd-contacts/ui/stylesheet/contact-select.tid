tags: $:/tags/Stylesheet
title: $:/plugins/yan/hypergsd-contacts/ui/stylesheet/contact-select

/* The multi-contact search strip's chips: the link-items shape — inline-flex + middle + gap spaces the name from the × (the row-gap mechanism, because trim removes the inline whitespace and the chip is no gsd-list-item row); the margin spaces one chip from the next. */
.hgsd-contact-chip {
  display: inline-flex;
  align-items: center;
  vertical-align: middle;
  gap: 0.3em;
  margin-inline-end: 0.4em;
}