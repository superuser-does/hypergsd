caption: {{$:/language/hypergsd/Sections/Contact/Caption}}
description: {{$:/language/hypergsd/Sections/Contact/Description}}
tags: $:/tags/hypergsd/PanelTemplate $:/tags/hypergsd/PanelTemplate/Portion/1 $:/tags/hypergsd/ModalTemplate $:/tags/hypergsd/ModalTemplate/Portion/1
title: $:/plugins/yan/hypergsd-contacts/ui/attributes/contact

\whitespace trim

<!-- Ships from this sub-plugin so absence of HyperGSD-Contacts removes section and strings structurally. One pick-field over section-target: panel = immediate saves; modal = drafting on the data temp (the inherited contact arrives seeded by hgsd.new-button). New-button fallback suppressed in the modal — typed non-existent picks still offer create-and-add. -->
<%if [<section-type>match[action]] %>
<div>
  <div>
    {{$:/language/hypergsd/Sections/Contact/Label}}
    <br/>
    <$hgsd.pick-field
      tiddler=<<section-target>>
      field="gsd_contact"
      list-filter="[tag[$:/GSD/Contact]]"
      id="contact"
      new-type="contact"
      new-status="next"
      new-update-status="true"
      new-button={{{ [<section-mode>match[modal]then[hide]else[show]] }}}
    />
  </div>
</div>
<%endif%>