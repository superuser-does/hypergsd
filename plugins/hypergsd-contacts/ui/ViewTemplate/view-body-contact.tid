title: $:/plugins/yan/hypergsd-contacts/ui/ViewTemplate/view-body-contact

\whitespace trim

<% if [is[current]tag[$:/GSD/Contact]] %>
<div class="project-view-template">
<!-- Freezes the view against the global refresh cycle. Scoped by SUBTRACTION runs (a second :and chain would wipe the first's output): the additive runs let item/config changes and ALL temps through, then the subtraction runs drop OTHER hosts' temps, so a toggle or collapse in one view refreshes only that view. A host name that is a prefix/suffix of another host's over-refreshes — never under-refreshes. -->
<$let this-liststate-prefix={{{ [[$:/temp/gsd-list/]addsuffix<currentTiddler>] }}} >
<$refresh subfilter="[subfilter<hgsd-type-gate>] [prefix[$:/config/hypergsd]] [prefix[$:/temp/gsd-list/]] [prefix[$:/state/hypergsd/show-completed/]] [prefix[$:/tags/hypergsd/ListItem]] [tags[]prefix[$:/tags/hypergsd/ListItem]] [prefix[$:/state/hypergsd/contextualise]] [prefix[$:/state/popup/pick-contextualise]] [prefix[$:/temp/hypergsd/add-context-]] -[prefix[$:/temp/gsd-list/]!prefix<this-liststate-prefix>] -[prefix[$:/state/hypergsd/show-completed/]!suffix<currentTiddler>] -[is[draft]]">
<!-- Centralised O(1) event listener for all checkboxes and buttons in this view. -->
<$eventcatcher selector=".hgsd-interactive input, .hgsd-interactive button" $click=<<hgsd-handle-click>> >
  <!-- Every block is a $hgsd.list invocation, so realm scoping, grouping, frozen refresh and the shared row composer all apply. Member visibility and drag-reorder are admitted by the hgsd-dashboard-portions gate this row now transcludes (the chassis carries its own refresh); the completed list is a Portion/Full member that self-toggles via $hgsd.toggle. section-target carries the contact past the chassis's block-mode transclusion, mirroring view-body-project. -->
  <$set name="section-target" value=<<currentTiddler>>>
    <$transclude $variable="hgsd-dashboard-portions" tag-list="$:/tags/hypergsd/Lists/ContactAction" visibility-base="$:/config/hypergsd/Lists/ContactAction/visibility/"/>
  </$set>
</$eventcatcher>
</$refresh>
</$let>
</div>
<% endif %>