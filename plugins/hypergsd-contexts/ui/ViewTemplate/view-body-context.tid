list-after: $:/core/ui/ViewTemplate/body
tags: $:/tags/ViewTemplate
title: $:/plugins/yan/hypergsd-contexts/ui/ViewTemplate/view-body-context

\whitespace trim
\procedure lingo-base() $:/language/hypergsd/Lists/

<!-- Refresh gate (outside the type test: without it the is[current]tag condition re-evaluated on every global cycle, per open page — same fix as view-body and the placement slot). Admission: the type test's own input ([tag[GSD/Contexts]], input-driven), the machinery below (type-gate, config/state prefixes — the group-by checkbox writes $:/state/hypergsd/context-group — gsd-list temps, pick popups, the row fragment's add-context temp, ListItem runs), member-list edits (ContextAction tag/prefix runs: a new member matches tag[], drag-reorder and untag write the tag tiddler itself, which prefix[] catches), deletions. -->
<$refresh subfilter="[tag[GSD/Contexts]] [subfilter<hgsd-type-gate>] [tag[$:/tags/hypergsd/Type]] [tag[$:/tags/hypergsd/Lists/ContextAction]] [prefix[$:/tags/hypergsd/Lists/ContextAction]] [prefix[$:/config/hypergsd]] [prefix[$:/state/hypergsd]] [prefix[$:/temp/gsd-list]] [prefix[$:/state/popup/pick-]] [prefix[$:/temp/hypergsd/add-context-]] [prefix[$:/tags/hypergsd/ListItem]] [tags[]prefix[$:/tags/hypergsd/ListItem]] [!is[tiddler]] -[is[draft]]">
<%if [is[current]tag[GSD/Contexts]] %>
<div class="context-view-template">
    <h3><<lingo Context/Heading>></h3>
    <!-- Group-by-project toggle shared by every block (each reads the state itself; default grouped). -->
    <div class="hgsd-context-controls">
        <$checkbox
            tiddler="$:/state/hypergsd/context-group"
            field="text"
            checked="true"
            unchecked="false"
            default="true">
            &nbsp;<<lingo GroupByProject>>
        </$checkbox>
    </div>

    <!-- Every block is a $hgsd.list invocation filtering actions TAGGED with this context (currentTiddler survives the loop via the list variable), so realm scoping, grouping support and the shared row composer all apply. -->
    <$list filter="[[$:/tags/hypergsd/Lists/ContextAction]] :and[tagging[]]" variable="context-list">
        <%if [[$:/config/hypergsd/Lists/ContextAction/visibility/]addsuffix<context-list>get[text]else[show]match[show]] %>
            <$transclude $tiddler=<<context-list>> $mode="block"/>
        <%endif%>
    </$list>
</div>
<%endif%>
</$refresh>