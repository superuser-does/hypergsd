list-after: $:/core/ui/ViewTemplate/body
tags: $:/tags/ViewTemplate
title: $:/plugins/yan/hypergsd-contexts/ui/ViewTemplate/view-body-context

\whitespace trim
\procedure lingo-base() $:/language/hypergsd/Lists/

<!-- Gate composition for the context page's freeze (below): row fragment runs, ContextAction member runs and the transitive strip runs (section-portions.tid's derivations), plus the base. The contexts fragment's pick temp arrives via its own hgsd-refresh-whitelist declaration — no hand-copied run. -->
\function hgsd-view-body-context-whitelist(base-whitelist:"[tag[GSD/Contexts]] [subfilter<hgsd-type-gate>] [tag[$:/tags/hypergsd/Type]] [tag[$:/tags/hypergsd/Lists/ContextAction]] [prefix[$:/tags/hypergsd/Lists/ContextAction]] [prefix[$:/config/hypergsd]] [prefix[$:/state/hypergsd]] [prefix[$:/state/folded/]] [prefix[$:/temp/gsd-list]] [prefix[$:/state/popup/pick-]] [prefix[$:/tags/hypergsd/Fragment]] [tags[]prefix[$:/tags/hypergsd/Fragment]] [!is[tiddler]] -[is[draft]]")
[function[hgsd-row-feature-runs]] [function[hgsd-member-feature-runs]] [function[hgsd-chassis-strip-feature-runs]] [<base-whitelist>] +[join[ ]]
\end

<!-- Refresh gate (outside the type test: without it the is[current]tag condition re-evaluated on every global cycle, per open page — same fix as view-body and the placement slot). Admission: the type test's own input ([tag[GSD/Contexts]], input-driven), the machinery below (type-gate, config/state prefixes — the group-by checkbox writes $:/state/hypergsd/context-group — gsd-list temps, pick popups, ListItem runs), member-list edits (ContextAction tag/prefix runs: a new member matches tag[], drag-reorder and untag write the tag tiddler itself, which prefix[] catches), feature-owned runs derived from hgsd-refresh-whitelist declarations, deletions. -->
<$let tag-list="$:/tags/hypergsd/Lists/ContextAction" strip-hosts-regex={{{ [[$:/tags/hypergsd/Lists/ContextAction]] :and[tagging[]] :and[get[hgsd-heading]get[text]] [[·]] +[join[|]addprefix[^(]addsuffix[)$]] }}}>
<$refresh subfilter={{{ [function[hgsd-view-body-context-whitelist]] }}} subfilter-tag-inputs="$:/tags/hypergsd/Lists/ContextAction $:/tags/hypergsd/Fragment/Row/Prefix $:/tags/hypergsd/Fragment/Row/Suffix $:/tags/hypergsd/Strip">
<%if [is[current]tag[GSD/Contexts]] %>
<!-- View folding: the view's own reveal wraps heading, toggle and chassis together, so a folded tiddler hides the whole context block; the chassis nests its own reveal on the same state title inside, and both flip together. The reveal sits INSIDE this view's gate, so the gate's whitelist carries the folded prefix above. -->
<$reveal tag="div" class="hgsd-fold-slot hgsd-fold-view" type="nomatch" stateTitle={{{ [[$:/state/folded/]addsuffix<currentTiddler>] }}} text="hide" default="show" retain="yes" animate="yes">
<div class="context-view-template">
  <h3><<lingo Context/Heading>></h3>
  <!-- Group-by-project toggle shared by every action block (each reads the state itself; default grouped). -->
  <div class="hgsd-context-controls">
    <$checkbox
      tiddler="$:/state/hypergsd/context-group"
      field="text"
      checked="true"
      unchecked="false"
      default="true">
      &nbsp;<<lingo GroupByProject>>
    </$checkbox>
  </div>

  <!-- The shared dashboard chassis over the ContextAction blocks (the contact view's shape): the three action blocks are untagged, so they stack in Portion/1 exactly as before; the projects block claims Portion/Full, the band below the actions. Member visibility, drag-reorder and Portion claims are the chassis's own. section-target carries the context past the chassis's block-mode transclusion. -->
  <$eventcatcher selector=".hgsd-interactive input, .hgsd-interactive button" $click=<<hgsd-handle-click>> >
    <$set name="section-target" value=<<currentTiddler>>>
      <$transclude $variable="hgsd-dashboard-portions" tag-list=<<tag-list>> visibility-base="$:/config/hypergsd/Lists/ContextAction/visibility/"/>
    </$set>
  </$eventcatcher>
</div>
</$reveal>
<%endif%>
</$refresh>
</$let>