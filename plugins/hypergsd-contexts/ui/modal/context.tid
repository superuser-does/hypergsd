caption: {{$:/language/hypergsd/Sections/Context/Caption}}
description: {{$:/language/hypergsd/Sections/Context/Description}}
list-before: $:/plugins/yan/hypergsd/ui/modal/realm
tags: $:/tags/hypergsd/ModalTemplate $:/tags/hypergsd/ModalTemplate/Portion/2
title: $:/plugins/yan/hypergsd-contexts/ui/modal/context

\whitespace trim
\procedure lingo-base() $:/language/hypergsd/Sections/
<%if [<current-type>!match[context]!match[reference]!match[contact]] %>
<$let picked-contexts={{{ [<new-state>get[gsd_context]enlist-input[]format:titlelist[]join[ ]] }}}>
<!-- gsd_context is a LIST on new-state: pick-append appends into it (dropdown instant commit, Enter, the Add button), the pills strip from it, the Inheritance rule enlists it at submit. The caption renders as plain text above and the label wraps the add-row alone: the label cannot start at the caption because the pills strip renders between them, and a label's whole content becomes the input's accessible name — every pill and its clear button would join it (label activation would reach the picker, never a pill button, but the name would carry them all). $edit-text forwards no id, so for/id cannot reach the widget's input either; the sr-only caption inside the label is the one naming path, its text a deliberate duplicate of the visible caption. The candidate exclusion rides the ambient let: already-picked contexts drop out of the dropdown, so the append cannot duplicate (the contextualise picker's shape). The plain new fallback self-suppresses in this modal host (hgsd-new-fallback's ambient section-mode gate); create-and-add for a typed unknown name stays, its caption trailing the accessible name while visible. Candidates ride the pick's default realm selection — a realm-tagged context follows the realm selection, like projects and contacts. -->
<<lingo Context/Label>>
<br />
<div class="hgsd-context-entries">
  <$list filter="[<new-state>get[gsd_context]enlist-input[]]" variable="context-item">
    <span class="hgsd-context-entry">
      <$macrocall $name="tag" tag=<<context-item>>/>
      <$button class="tc-btn-invisible hgsd-clear-button" tooltip={{$:/language/Buttons/Clear/Caption}}>
        <$action-listops $tiddler=<<new-state>> $field="gsd_context" $subfilter="-[<context-item>]"/>
        {{$:/core/images/close-button}}
      </$button>
    </span>
  </$list>
</div>
<label><span class="hgsd-screen-reader-only"><<lingo Context/Label>></span>
<$hgsd.pick-append
  tiddler=<<new-state>>
  field="gsd_context"
  id="context"
  list-filter="[tag[GSD/Contexts]] -[enlist<picked-contexts>]"
  none-label={{$:/language/hypergsd/Sections/Context/Choose}}
  new-type="context"
  new-status="next"/>
</label>
</$let>
<%endif%>