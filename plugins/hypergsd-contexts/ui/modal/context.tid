caption: {{$:/language/hypergsd/Sections/Context/Caption}}
description: {{$:/language/hypergsd/Sections/Context/Description}}
list-before: $:/plugins/yan/hypergsd/ui/modal/realm
tags: $:/tags/hypergsd/ModalTemplate $:/tags/hypergsd/ModalTemplate/Portion/2
title: $:/plugins/yan/hypergsd-contexts/ui/modal/context

\whitespace trim
\procedure lingo-base() $:/language/hypergsd/Sections/
<%if [<current-type>!match[context]!match[reference]!match[contact]] %>
<label>
<<lingo Context/Label>>
<br/>
<$hgsd.pick
  tiddler=<<new-state>>
  field="gsd_context"
  list-filter="[tag[GSD/Contexts]]"
  initial={{{ [[$:/state/hypergsd/effective-context]get[text]] }}}
  none-label={{$:/language/hypergsd/Sections/Context/None}}
  id="context"
  realm-scope=""/>
<%if [<new-state>get[gsd_context]!match[]] :and[!is[tiddler]] %>
  <$transclude $variable="hgsd-create-and-add"
    typed-pick={{{ [<new-state>get[gsd_context]] }}}
    new-type="context"
    new-status="next"
    target-tiddler=<<new-state>>
    target-field="gsd_context"/>
<%endif%>
</label>
<%endif%>