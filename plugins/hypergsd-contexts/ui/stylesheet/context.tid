/* The contextualise cluster (list-items/context): inline-flex + gap spaces the context pills, the button and an open picker uniformly — trim removed the inline whitespace and the pills' padding sits inside their coloured boxes, so the boxes would otherwise meet edge-to-edge (the picked-contact entry's shape — the family's inline-entry gap convention). */
.hgsd-contextualise {
  display: inline-flex;
  align-items: center;
  gap: 0.3em;
}

/* Context view header */
.context-view-template {
  margin-top: 2em;
}
.hgsd-context-controls {
  margin-block-end: 1em;
}