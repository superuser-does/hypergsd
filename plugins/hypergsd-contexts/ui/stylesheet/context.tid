/* The contextualise cluster (list-items/context): inline-flex + gap spaces the context pills, the button and an open picker uniformly — trim removed the inline whitespace and the pills' padding sits inside their coloured boxes, so the boxes would otherwise meet edge-to-edge (the picked-contact entry's shape — the family's inline-entry gap convention). */
.hgsd-contextualise {
  display: inline-flex;
  align-items: center;
  gap: 0.3em;
}

/* The modal's picked-context entries (ui/modal/context): the contact-entry shape — the container's flex + gap spaces the entries, the entry's inline-flex + gap the pill from its ×, because trim removes the inline whitespace between them; :empty collapses the container while no context is picked. */
.hgsd-context-entries {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.3em;
  margin-block-end: 0.3em;
  &:empty {
    display: none;
  }
  .hgsd-context-entry {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
  }
}

/* Context view header */
.context-view-template {
  margin-top: 2em;
}
.hgsd-context-controls {
  margin-block-end: 1em;
}