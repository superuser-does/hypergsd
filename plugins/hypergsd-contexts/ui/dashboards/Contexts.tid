hgsd-type: context
icon: $:/plugins/yan/hypergsd-contexts/images/context
tags: $:/tags/hypergsd/Type
title: GSD/Contexts

\whitespace trim
\procedure add-context-actions()
<$let newContextState="$:/temp/hypergsd/NewContextName"
  newContextName={{{ [<newContextState>get[text]trim[]] }}}>
  <$list filter="[<newContextName>!is[blank]]" variable="ignore">
    <!-- Tags the tiddler with this dashboard's own title — the dashboard IS the context tag list (user-data tag lists are open GSD/* dashboard tags; extension tag lists stay $:/tags/hypergsd/*). If the tiddler does not exist, TW creates it automatically with the tag. -->
    <$action-listops $tiddler=<<newContextName>> $tags="[[GSD/Contexts]]" />
    <$action-deletetiddler $tiddler=<<newContextState>> />
    <$action-navigate $to=<<newContextName>> />
  </$list>
</$let>
\end

<!-- The add row: gsd-list-item's gap spaces the input and the Add button (trim removes their inter-widget whitespace), and the wrapper div carries the print hook on an element with no display rule of its own — the pick-append pattern, so the print hide never needs a specificity escalation. -->
<div class="hgsd-pick-append-row">
  <div class="gsd-list-item">
    <$let newContextState="$:/temp/hypergsd/NewContextName">
      <$keyboard key="enter" actions=<<add-context-actions>>>
        <$edit-text tiddler=<<newContextState>> field="text" placeholder={{$:/language/hypergsd/Dashboards/Contexts/NewContext/Placeholder}} tag="input" />
      </$keyboard>
      <$button actions=<<add-context-actions>>>
        {{$:/language/EditTemplate/Fields/Add/Button}}
      </$button>
    </$let>
  </div>
</div>

<ul>
<$list filter="[tag[GSD/Contexts]!is[draft]]">
  <li><$link to=<<currentTiddler>>><$view field="title"/></$link></li>
</$list>
</ul>