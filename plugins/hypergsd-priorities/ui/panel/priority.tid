caption: {{$:/language/hypergsd/Sections/Priority/Caption}}
description: {{$:/language/hypergsd/Sections/Priority/Description}}
tags: $:/tags/hypergsd/PanelTemplate $:/tags/hypergsd/PanelTemplate/Portion/0
title: $:/plugins/yan/hypergsd-priorities/ui/panel/priority

\whitespace trim
\procedure lingo-base() $:/language/hypergsd/Sections/

<!-- Hairline option blocks over raw radios behind the section's own eventcatcher (the status-pill architecture: the catcher receives the label-forwarded click and hgsd-priority-click writes through the shared hgsd-priority-set). Each row carries its letter as a hook class; the stylesheet's generated rules hang the --priority-* custom properties on it, and the selected block fills via :has(input:checked) — no colour lives in this template, the colours dictionary is the single source. Every block reserves end space for the clear ✕ (so widths never change and translated labels of any width cannot collide with it); the ✕ renders in that slot on the selected row only, its ink riding the same --priority-ink variable. Portion/0 places the column before every other portion; the write re-renders the panel through the type gate, so the section keeps no state of its own. -->
<%if [is[current]tag[$:/GSD/Action]] [is[current]tag[$:/GSD/Project]] %>
<$let priority-letter={{{ [all[current]get[gsd_priority]] }}}
  radio-name={{{ [<currentTiddler>addsuffix[-priority]] }}}>
<span><<lingo Priority/Label>></span>
<$eventcatcher tag="div" selector=".hgsd-priority-option input" $click=<<hgsd-priority-click>>>
<$list filter="[enlist[A B C]]" variable="priority-stop">
  <$let stop-label={{{ [[$:/language/hypergsd/Lists/Priorities/Name/]addsuffix<priority-stop>get[text]else[]trim[]minlength[1]] [<priority-stop>] +[limit[1]] }}}>
  <div class={{{ [[hgsd-priority-row hgsd-priority-]addsuffix<priority-stop>] }}}>
    <label class="hgsd-priority-option">
      <%if [<priority-stop>match<priority-letter>] %>
      <input type="radio" name=<<radio-name>> data-tiddler=<<currentTiddler>> data-priority=<<priority-stop>> checked>
      <%else%>
      <input type="radio" name=<<radio-name>> data-tiddler=<<currentTiddler>> data-priority=<<priority-stop>>>
      <%endif%>
      <span><$text text=<<stop-label>>/></span>
    </label>
    <%if [<priority-stop>match<priority-letter>] %>
      <$button class="tc-btn-invisible hgsd-priority-clear" tooltip={{$:/language/hypergsd/Sections/Priority/Clear/Hint}}>
        <$transclude $variable="hgsd-priority-set" item-title=<<currentTiddler>> priority-value=""/>
        {{$:/core/images/close-button}}
      </$button>
    <%endif%>
  </div>
  </$let>
</$list>
</$eventcatcher>
</$let>
<%endif%>