caption: {{$:/language/hypergsd/Settings/Fragments/Priority/Caption}}
description: {{$:/language/hypergsd/Settings/Fragments/Priority/Hint}}
hgsd-refresh-whitelist: [prefix[$:/plugins/yan/hypergsd-priorities/ui/config]] [prefix[$:/language/hypergsd/Lists]]
list-after: $:/plugins/yan/hypergsd/ui/list-items/status
tags: $:/tags/hypergsd/ListItem/Prefix
title: $:/plugins/yan/hypergsd-priorities/ui/list-items/priority

\whitespace trim
\procedure lingo-base() $:/language/hypergsd/Lists/

<!-- The row select: pinned after the status pills (the Prefix tag tiddler's list field — a dangling entry when this sub-plugin is absent, which tagging[] drops harmlessly). Native <select> appearance kept — the closed box paints fill + ink from the letter hook class the wrapper span carries (the stylesheet's generated custom properties; no letter, no hook class, transparent box), and the dropdown options are coloured by the stylesheet's generated rules straight from the colours dictionary (the $select widget rebuilds <option> nodes itself and drops foreign attributes, so per-option inline styles cannot ride through — the dictionary stays the single source). The select paints transparent over the span's fill. The select binds the field natively (that write keeps the DOM honest), then its actions normalise through the shared hgsd-priority-set — every surface commits through the one write path, and clearing deletes the field instead of leaving an empty string. Self-gated: actions and projects, incomplete rows only (done rows drop their pills too). The wrapper span joins the row's flex-shrink:0 set (a bare select would squeeze under title pressure). -->
<$let item-title=<<currentTiddler>>
  item-type={{{ [all[current]tags[]] :filter[tag[$:/tags/hypergsd/Type]] :and[get[hgsd-type]] }}}>
<%if [<item-type>match[action]] [<item-type>match[project]] %>
<%if [is[current]gsd_complete[false]] %>
<$let priority-letter={{{ [<item-title>get[gsd_priority]else[]trim[]] }}}>
<span class={{{ [<priority-letter>minlength[1]then[hgsd-row-priority hgsd-priority-]addsuffix<priority-letter>else[hgsd-row-priority]] }}}>
<$select class="hgsd-priority-select" tooltip={{$:/language/hypergsd/Lists/Priorities/Row/Hint}}
  tiddler=<<item-title>> field="gsd_priority" default=""
  actions="""<$transclude $variable="hgsd-priority-set" item-title=<<item-title>> priority-value={{{ [<item-title>get[gsd_priority]else[]trim[]] }}} />""">
  <option value=""><$text text={{{ [[$:/language/hypergsd/Lists/Priorities/Unset]get[text]else[–]] }}} /></option>
  <$list filter="[enlist[A B C]]" variable="priority-stop">
    <$let stop-label={{{ [[$:/language/hypergsd/Lists/Priorities/Short/]addsuffix<priority-stop>get[text]else[]trim[]minlength[1]] [[$:/language/hypergsd/Lists/Priorities/Name/]addsuffix<priority-stop>get[text]else[]trim[]minlength[1]] [<priority-stop>] +[limit[1]] }}}>
    <option value=<<priority-stop>> ><$text text=<<stop-label>>/></option>
    </$let>
  </$list>
</$select>
</span>
</$let>
<%endif%>
<%endif%>
</$let>