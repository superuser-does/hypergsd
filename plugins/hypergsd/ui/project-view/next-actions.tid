caption: {{$:/language/hypergsd/Lists/NextActions}}
hgsd-heading: $:/language/hypergsd/Lists/NextActions
tags: $:/tags/hypergsd/ProjectView
title: $:/plugins/yan/hypergsd/ui/project-view/next-actions

\whitespace trim

<!-- Project-view list member rendered by the shared $hgsd.list widget (its view controls are opt-in, so this page shows no group-by/sort-by strip; realm-scope blank keeps the project's own page unscoped where dashboards honour the realm filter). section-target (set by view-body-project around the chassis) carries the project past the shared chassis into this member; the $set binds it as currentTiddler for the filter and the quick-add button, independent of the hosting scope. -->
<$set name="currentTiddler" value=<<section-target>>>
<$hgsd.list
  list-heading="$:/language/hypergsd/Lists/NextActions"
  list-filter="[tag[$:/GSD/Action]!is[draft]gsd_project<currentTiddler>gsd_status[next]gsd_complete[false]]"
  realm-scope=""
  add-button=<<new-next-action-button>>/>
</$set>