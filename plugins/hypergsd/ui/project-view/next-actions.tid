caption: {{$:/language/hypergsd/Lists/NextActions}}
tags: $:/tags/hypergsd/ProjectView
title: $:/plugins/yan/hypergsd/ui/project-view/next-actions

\whitespace trim

<!-- Project-view list member rendered by the shared $hgsd.list widget (its view controls are opt-in, so this page shows no group-by/sort-by strip; realm-scope blank keeps the project's own page unscoped where dashboards honour the realm filter). The chassis transcludes this in block mode, rebinding currentTiddler to this member tiddler; section-target (set by view-body-project around the chassis) carries the project, so the $set restores it for the filter and the quick-add button. -->
<$set name="currentTiddler" value=<<section-target>>>
<$hgsd.list
  list-heading={{$:/language/hypergsd/Lists/NextActions}}
  list-filter="[tag[$:/GSD/Action]!is[draft]gsd_project<currentTiddler>gsd_status[next]gsd_complete[false]]"
  realm-scope=""
  add-button=<<new-next-action-button>>/>
</$set>