caption: {{$:/language/hypergsd/Lists/Subprojects}}
hgsd-heading: $:/language/hypergsd/Lists/Subprojects
tags: $:/tags/hypergsd/ProjectView $:/tags/hypergsd/ProjectView/Portion/Full
title: $:/plugins/yan/hypergsd/ui/project-view/subprojects

\whitespace trim

<!-- Project-view list member rendered by the shared $hgsd.list widget (its view controls are opt-in, so this page shows no group-by/sort-by strip; realm-scope blank keeps the project's own page unscoped where dashboards honour the realm filter; Portion/Full keeps it in the trailing band). section-target (set by view-body-project around the chassis) carries the project past the shared chassis into this member; the $set binds it as currentTiddler for the filter and the quick-add button, independent of the hosting scope. -->
<$set name="currentTiddler" value=<<section-target>>>
<$hgsd.list
  list-heading="$:/language/hypergsd/Lists/Subprojects"
  list-filter="[tag[$:/GSD/Project]!is[draft]gsd_project<currentTiddler>sort[gsd_status]sort[gsd_complete]]"
  realm-scope=""
  add-button=<<new-subproject-button>>/> <!-- gsd_status sorts "active" before "future", then completed projects last; equal keys fall back to the default title order -->
</$set>