tags: $:/tags/Stylesheet
title: $:/plugins/yan/hypergsd/ui/stylesheet/stylesheet

/* Visually hidden but available to assistive tech */
.hgsd-screen-reader-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip-path: inset(50%);
  white-space: nowrap;
  border: 0;
}

.gsd-small-text {
  font-size: 0.8em;
}

.hgsd-slightly-large-text {
  font-size: 1.1em;
}

.gsd-muted {
  color: <<colour muted-foreground>>;
  fill: <<colour muted-foreground>>;
}

.gsd-button:hover {
  color: <<colour sidebar-muted-foreground-hover>>;
  fill: <<colour sidebar-muted-foreground-hover>>;
}

/* Realm selection fieldset (review sidebar + embeddable component): native
   fieldset chrome removed; the stacking layout is the inline display:grid on
   the element itself, not a rule here. */
.hgsd-realm-fieldset {
  border: none;
  margin: 0;
  padding: 0;
  & legend {
    margin-block-end: 0.25em;
  }
}

.project-view-template {
  margin-bottom: 4em;
}

/* Centre, not stretch — rows pairing this class with .gsd-list-item rely on
   the shared alignment resolving to centre. */
.hgsd-sizer-droplist {
  display: flex;
  align-items: center;
}

.hgsd-sizer-select {
  flex: 1 1 0;
  min-width: 0;
  & > select {
    width: 100%;
    box-sizing: border-box;
  }
}

/* An input inside a tag pill (modal "new realm", contexts add-row): the input
   carries core's tc-edit-texteditor chrome inside core's own add-name wrapper
   (the add-field row's pattern — the wrapper's width:auto is what keeps a
   framed host's width:100% editor rule from stretching the pill), so framed
   hosts get the full editor look from the theme itself. This rule supplies
   only what an unframed host (the modal) cannot inherit: the editor tint and
   padding transcluded from the palette, the border in the theme's
   editor-border ink, appearance reset for chrome parity. The box width is the
   native size-attribute behaviour (fixed, content scrolls — every core
   editor input): a field-sizing/content experiment made the empty box snap
   down to its min-inline-size floor on the first keystroke (the empty box had
   sized to the placeholder, a hair above the floor), so growth went. The
   descendant selector outranks the theme's bare-input rule on specificity —
   stylesheet order puts themes after plugins, so a single-class selector
   would lose. */
.tc-tag-label .hgsd-tag-pill-input {
  appearance: none;
  background: <<colour tiddler-editor-background>>;
  border: 1px solid <<colour tiddler-editor-border>>;
  padding: 3px;
  font: inherit;
}

/* 2026-09-27: the former margin-inline-start sat INSIDE the fallback button,
   an asymmetric gap before the word with none after — the button's own padding
   separates it now (the row carries no flex gap; adjacent buttons space
   themselves via core button padding). */
.hgsd-new-hint {
  text-decoration: underline;
}

/* Sidebars: the vertical gap between numbered portions (modules/section-portions, class on the wrapper div) — sibling selector so the first and last portions get no extra margin; a portion whose members are all hidden renders empty and collapses. */
.hgsd-sidebar-portions > div {
  &:empty {
    display: none;
  }
  & + div {
    margin-top: 1em;
  }
}