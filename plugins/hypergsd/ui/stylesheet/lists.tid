tags: $:/tags/Stylesheet
title: $:/plugins/yan/hypergsd/ui/stylesheet/lists

.gsd-list-heading {
  font-weight: 600;
  /* Collapse toggle input is hidden — the whole title label is the click target */
  & input[type=checkbox] {
    display: none;
  }
  & svg {
    height: 1em;
  }
}

.gsd-list-new-button svg {
  margin-inline-start: 0.5em;
}

/* Rows: gap is the sole spacing between members — invisible buttons carry no padding and flex never renders inter-widget whitespace, so nothing else separates the controls; the panel chassis is excluded because its children are the portion bands, which space themselves by margin. */
.gsd-list-item:not(.gsd-panel) {
  display: flex;
  align-items: center;
  gap: 0.3em;
  padding-bottom: 0.3em;
}

/* Row children other than the title link refuse to shrink; the title flexes. */
.gsd-list-item > div,
.gsd-list-item > span {
  flex-shrink: 0;
}

/* The title link opts out of the defaults that overflow narrow screens:
   core sets overflow-wrap:break-word on body.tc-body, which breaks an
   over-long word in flowing text but does NOT lower min-content — so the
   flexbox floor (min-width:auto) kept the item at its longest token and one
   long identifier in one title floored its row — and the whole column,
   through the min-content chain — past the viewport edge. anywhere DOES
   lower min-content; min-width:0 lets the item actually shrink that far
   (anywhere alone still left 9px at 360px). Titles wrap at word boundaries
   except when a single token alone exceeds the available width. */
.gsd-list-item > a {
  min-width: 0;
  overflow-wrap: anywhere;
}

/* LinkItem container: inline-flex + middle keeps members centred after the link in any host; members carry no alignment CSS of their own.
   The :empty collapse is display:none — an empty span still counts as a flex item and would contribute a gap on both sides. */
.hgsd-link-items {
  display: inline-flex;
  align-items: center;
  vertical-align: middle;
  &:empty {
    display: none;
  }
}

/* pick-field's set state wraps each control in its own reveal, so an empty link-items span hides behind a bare tc-reveal flex item — the wrapper collapses too, or the clear button would sit two gaps from the value. */
.gsd-list-item > .tc-reveal:has(> .hgsd-link-items:empty) {
  display: none;
}

.hgsd-group-title {
  padding-block: 0.5em 0.2em;
  &:first-of-type {
    padding-top: 0;
  }
  & a {
    color: inherit;
  }
}

.hgsd-completed-toggle {
  margin-top: 1em;
}
.hgsd-toggle-open {
  margin-block: 1em;
}

/* Grouping strip: a flex row — the gap spaces the controls (the sort block,
   each dimension radio, the ungrouped checkbox) and keeps wrapped lines
   readable on narrow viewports. The gap guarantees a space after every colon
   in every locale — no hug rules, entities or spacer elements. */
.hgsd-group-strip {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.3em 0.75em;
  margin-block: 0.3em;
}

/* List-settings picker cluster (list-item-template): the strip's spacing
   mechanism reused — the gap spaces the pickers. */
.hgsd-list-pickers {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  column-gap: 0.75em;
}