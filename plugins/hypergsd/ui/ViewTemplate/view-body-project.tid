title: $:/plugins/yan/hypergsd/ui/ViewTemplate/view-body-project

\whitespace trim

<!-- Gate composition for the project view's freeze (below): ListItem fragment runs, ProjectView member runs and the transitive strip runs (section-portions.tid's derivations), plus the base — the base's scoped subtraction runs stay literal data until the subfilter evaluates them. -->
\function hgsd-view-body-project-whitelist(base-whitelist:"[subfilter<hgsd-type-gate>] [prefix[$:/config/hypergsd]] [prefix[$:/temp/gsd-list/]] [prefix[$:/state/hypergsd/show-completed/]] [prefix[$:/state/folded/]] [prefix[$:/tags/hypergsd/ListItem]] [tags[]prefix[$:/tags/hypergsd/ListItem]] -[prefix[$:/temp/gsd-list/]!prefix<this-list-prefix>] -[prefix[$:/state/hypergsd/show-completed/]!suffix<currentTiddler>] -[is[draft]]")
[function[hgsd-listitem-feature-runs]] [function[hgsd-member-feature-runs]] [function[hgsd-chassis-strip-feature-runs]] [<base-whitelist>] +[join[ ]]
\end

<% if [is[current]tag[$:/GSD/Project]] %>
<div class="project-view-template">
<!-- Freezes the view against the global refresh cycle. Scoped by SUBTRACTION runs (a second :and chain would wipe the first's output): the additive runs let item/config changes and ALL temps through, then the subtraction runs drop OTHER hosts' temps, so a toggle or collapse in one view refreshes only that view. A host name that is a prefix/suffix of another host's over-refreshes — never under-refreshes. The folded-state prefix (additive, before the subtractions — they only subtract gsd-list temps and show-completed states) reaches the fold reveal the dashboard chassis carries around this view's lists. Member visibility and drag-reorder are admitted by the hgsd-dashboard-portions gate this row now transcludes (the chassis carries its own refresh). Feature-owned runs (row fragments, ProjectView members, strips hosted on their lists) are derived from hgsd-refresh-whitelist declarations. -->
<$let this-list-prefix={{{ [[$:/temp/gsd-list/]addsuffix<currentTiddler>] }}} >
<$let tag-list="$:/tags/hypergsd/ProjectView" strip-hosts-regex={{{ [[$:/tags/hypergsd/ProjectView]] :and[tagging[]] :and[get[hgsd-heading]get[text]] [[·]] +[join[|]addprefix[^(]addsuffix[)$]] }}}>
<$refresh subfilter={{{ [function[hgsd-view-body-project-whitelist]] }}} subfilter-tag-inputs="$:/tags/hypergsd/ProjectView $:/tags/hypergsd/ListItem/Prefix $:/tags/hypergsd/ListItem/Suffix $:/tags/hypergsd/Strip">
<$eventcatcher selector=".hgsd-interactive input, .hgsd-interactive button" $click=<<hgsd-handle-click>> >
<!-- section-target carries the project past the chassis's block-mode transclusion, which rebinds currentTiddler to each member tiddler; every member restores currentTiddler from this. -->
<$set name="section-target" value=<<currentTiddler>>>
<$transclude $variable="hgsd-dashboard-portions" tag-list=<<tag-list>> visibility-base="$:/config/hypergsd/ProjectView/visibility/"/>
</$set>
</$eventcatcher>
</$refresh>
</$let>
</$let>
</div>
<% endif %>