caption: {{$:/language/hypergsd/Settings/Behaviour/Caption}}
tags: $:/tags/hypergsd/Settings
title: $:/plugins/yan/hypergsd/ui/control-panel/behaviour

\whitespace trim
\procedure lingo-base() $:/language/hypergsd/Settings/

<<lingo Behaviour/PickerInstantCommit>><br/>
<$checkbox tiddler="$:/config/hypergsd/picker-instant-commit/fine"
  field="text" checked="true" unchecked="false"
  class="tc-control-panel-item"
><$link to="$:/config/hypergsd/picker-instant-commit/fine" class="tc-tiny-gap-left"><<lingo Behaviour/PickerInstantCommit/Fine>></$link></$checkbox>
<br/>
<$checkbox tiddler="$:/config/hypergsd/picker-instant-commit/coarse"
  field="text" checked="true" unchecked="false"
  class="tc-control-panel-item"
><$link to="$:/config/hypergsd/picker-instant-commit/coarse" class="tc-tiny-gap-left"><<lingo Behaviour/PickerInstantCommit/Coarse>></$link></$checkbox>

<$checkbox tiddler="$:/config/hypergsd/inherit-tags"
  field="text" checked="yes" unchecked="no" default="yes"
  class="tc-control-panel-item"
><$link to="$:/config/hypergsd/inherit-tags" class="tc-tiny-gap-left"><<lingo Behaviour/InheritTags>></$link></$checkbox><br/>
//<<lingo Behaviour/InheritTags/Prompt>>//

<$checkbox tiddler="$:/config/hypergsd/new-action-navigate"
  field="text" checked="yes" unchecked="no" default="yes"
  class="tc-control-panel-item"
><$link to="$:/config/hypergsd/new-action-navigate" class="tc-tiny-gap-left"><<lingo Behaviour/NewActionNavigate>></$link></$checkbox>
<br/>
<$checkbox tiddler="$:/config/hypergsd/new-project-navigate"
  field="text" checked="yes" unchecked="no" default="yes"
  class="tc-control-panel-item"
><$link to="$:/config/hypergsd/new-project-navigate" class="tc-tiny-gap-left"><<lingo Behaviour/NewProjectNavigate>></$link></$checkbox>

<<lingo Behaviour/CloseOnComplete>><br/>
<$radio tiddler="$:/config/hypergsd/close-on-complete" value="always" default="never"><span class="tc-tiny-gap-left"><<lingo Behaviour/CloseOnComplete/Always>></span></$radio><br/>
<$radio tiddler="$:/config/hypergsd/close-on-complete" value="own-page" default="never"><span class="tc-tiny-gap-left"><<lingo Behaviour/CloseOnComplete/Itself>></span></$radio><br/>
<$radio tiddler="$:/config/hypergsd/close-on-complete" value="never" default="never"><span class="tc-tiny-gap-left"><<lingo Behaviour/CloseOnComplete/Never>></span></$radio>

<$checkbox tiddler="$:/config/hypergsd/print-blank-fields"
  field="text" checked="show" unchecked="hide" default="show"
  class="tc-control-panel-item"
><$link to="$:/config/hypergsd/print-blank-fields" class="tc-tiny-gap-left"><<lingo Behaviour/PrintBlankFields>></$link></$checkbox>