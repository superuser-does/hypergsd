caption: {{$:/language/hypergsd/Settings/Fragments/Caption}}
list-after: $:/plugins/yan/hypergsd/ui/control-panel/dashboards
tags: $:/tags/hypergsd/Settings/Lists
title: $:/plugins/yan/hypergsd/ui/control-panel/fragments

\whitespace trim
\procedure lingo-base() $:/language/hypergsd/Settings/

//<<lingo Fragments/Prompt>>//

<!-- One merged block over the Fragment root: one draggable per placement tag TIDDLER — enumerated by title prefix, so a family exists the moment its tag tiddler does (empty families stay visible as drag targets), and the tab names no tag title itself. Drag reorders within a placement; the placement select on each row moves a member between placements. The tag-basis line names the discovered placements as pills. note="no" suppresses hgsd-visibility-list's per-list tag-basis line; each call derives its visibility base from the placement tag. -->

<p>//<<lingo Fragments/TagBasis>> <$list filter="[all[shadows+tiddlers]prefix[$:/tags/hypergsd/Fragment/]] +[sort[title]]" variable="placement-pill">&#32;<$macrocall $name="tag" tag=<<placement-pill>> /></$list>.//</p>

<$list filter="[all[shadows+tiddlers]prefix[$:/tags/hypergsd/Fragment/]] +[sort[title]]" variable="placement-tag">
  <$transclude
    $variable="hgsd-visibility-list"
    tag-list=<<placement-tag>>
    visibility-base={{{ [<placement-tag>removeprefix[$:/tags/hypergsd/]addprefix[$:/config/hypergsd/]addsuffix[/visibility/]] }}}
    item-template="$:/plugins/yan/hypergsd/ui/components/fragment-item-template"
    note="no"/>
</$list>
