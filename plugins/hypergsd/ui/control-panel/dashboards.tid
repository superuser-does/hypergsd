caption: {{$:/language/hypergsd/Settings/Dashboards/Caption}}
list-after: $:/plugins/yan/hypergsd/ui/control-panel/project-view
tags: $:/tags/hypergsd/Settings/Lists
title: $:/plugins/yan/hypergsd/ui/control-panel/dashboards

\whitespace trim

\procedure lingo-base() $:/language/hypergsd/Settings/

! <<lingo Dashboards/General>>

<$checkbox tiddler="$:/config/hypergsd/dashboard-future-project-items"
    field="text" checked="show" unchecked="hide" default="hide"
    class="tc-control-panel-item"
><$link to="$:/config/hypergsd/dashboard-future-project-items" class="tc-tiny-gap-left"><<lingo Dashboards/FutureProjectItems>></$link></$checkbox>

! <<lingo Dashboards/Grouping/Heading>>

<$transclude
    $variable="hgsd-visibility-list"
    tag-list="$:/tags/hypergsd/GroupBy"
    visibility-base="$:/config/hypergsd/GroupBy/hidden/"
    item-template="$:/plugins/yan/hypergsd/ui/components/view-option-item-template"
    portions="no"/>

! <<lingo Dashboards/Sorting/Heading>>

<$transclude
    $variable="hgsd-visibility-list"
    tag-list="$:/tags/hypergsd/SortBy"
    visibility-base="$:/config/hypergsd/SortBy/hidden/"
    item-template="$:/plugins/yan/hypergsd/ui/components/view-option-item-template"
    portions="no"/>

! <<lingo Dashboards/Lists>>

//<<lingo Dashboards/Lists/Prompt>>//

<<tabs
    "[all[shadows+tiddlers]tag[$:/tags/hypergsd/Settings/Lists/Dashboard]!is[draft]]"
    "$:/plugins/yan/hypergsd/ui/control-panel/dashboards/main-dashboard-list"
    "$:/state/tab/hypergsdlistpanel"
    "tc-vertical">>