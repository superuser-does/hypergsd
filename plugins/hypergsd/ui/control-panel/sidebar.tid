<!-- One draggable per sidebar tab: members of $:/tags/hypergsd/Capture and $:/tags/hypergsd/Review with a numeric Portion picker on each row (bands="no" — the sidebars have no Top/Full slots). Drag-reorder writes the tag list's list field, hide writes $:/config/hypergsd/<Capture|Review>/visibility/<entry>, which the sidebar renderers honour. -->

! <<lingo Sidebar/CaptureHeading>>

<$transclude $variable="hgsd-visibility-list" tag-list="$:/tags/hypergsd/Capture" visibility-base="$:/config/hypergsd/Capture/visibility/" bands="no"/>

! <<lingo Sidebar/ReviewHeading>>

<$transclude $variable="hgsd-visibility-list" tag-list="$:/tags/hypergsd/Review" visibility-base="$:/config/hypergsd/Review/visibility/" bands="no"/>
