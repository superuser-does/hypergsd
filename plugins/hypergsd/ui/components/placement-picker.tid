title: $:/plugins/yan/hypergsd/ui/components/placement-picker

\whitespace trim

<!-- The Placement select for Fragments rows (ui/components/fragment-item-template), re-using the Portion select's mechanism: SelectWidget hands actions NO value variable, so the chosen tag travels through a per-row STATE tiddler the select writes first, which the retag filter reads back via list[] (a text reference in a variable operand). The options are every placement tag in the index — discovered over the Fragment root prefix, so a third-party Link family joins the select the moment a member carries its tag; the label is the tag tiddler's caption field (the shipped placements carry lingo transclusions; third parties fall back to the path's last segment). The retag is ONE prefix strip — every placement tag lives under the root — plus the append and dedupe (the list run stays UNPREFIXED, because a + run replaces the accumulator with its own output and list[] ignores its input). A member carries exactly ONE placement tag — multi-surface adornments ship as one member per family — so the select is never destructive; the retagged row joins its new family alphabetically. Actions attributes run BARE action widgets only. The select's default is the member's current placement tag. -->
<$let state-title={{{ [[$:/state/hypergsd/placement/]addsuffix<currentTiddler>] }}}
  state-ref={{{ [[$:/state/hypergsd/placement/]addsuffix<currentTiddler>addsuffix[!!text]] }}}>
<span class="hgsd-placement-picker" title={{$:/language/hypergsd/Settings/Fragments/Placement/Hint}}>
  <$select tiddler=<<state-title>> default={{{ [all[current]tags[]prefix[$:/tags/hypergsd/Fragment/]] +[first[1]] }}} actions="<$action-listops $tiddler=<<currentTiddler>> $tags='+[!prefix[$:/tags/hypergsd/Fragment/]] [list<state-ref>] +[unique[]]'/>">
    <$list filter="[all[shadows+tiddlers]tags[]prefix[$:/tags/hypergsd/Fragment/]] +[unique[]sort[title]]" variable="placement-option">
      <option value=<<placement-option>>>
        <$tiddler tiddler=<<placement-option>>>
          <$transclude field="caption">
            <$text text={{{ [<placement-option>removeprefix[$:/tags/hypergsd/Fragment/]split[/]last[1]] }}}/>
          </$transclude>
        </$tiddler>
      </option>
    </$list>
  </$select>
</span>
</$let>
