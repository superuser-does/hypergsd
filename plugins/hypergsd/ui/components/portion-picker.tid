title: $:/plugins/yan/hypergsd/ui/components/portion-picker

\whitespace trim

<!-- The Portion select for Settings rows, shared by portion-item-template and list-item-template. Core's SelectWidget hands actions NO value variable (handleChangeEvent → invokeActionString with no variables) — the chosen value travels through a per-row STATE tiddler the select writes first, which the retag filter then reads back via list[] (a text reference in a variable operand). One $action-listops: drop existing portion tags, append the state's value, dedupe — the append run must be UNPREFIXED, because a + run replaces the accumulator with its own output and list[] ignores its input (a +[list[...]] destroyed every non-portion tag it ran over). Actions attributes run BARE action widgets only — no <$list>/conditionals. The two band options sit outside the numbered $list, ordered as they render: Top first, Full last; a bands="no" host (the sidebar tabs — numbers only) drops both and swaps the tooltip to the numbered sentence. Numbered options order numerically past 9 (strip/nsort/re-prefix). Ambient scope from the hosting visibility-list: tag-list, portion-prefix, default-portion, top-portion, full-portion, next-free-portion-tag, portion-bands. -->
<$let hint-title={{{ [<portion-bands>!match[no]then[$:/language/hypergsd/Settings/PanelModal/Portion/Hint]else[$:/language/hypergsd/Settings/TagBasis/Portions/Numbered]] }}}>
<span class="hgsd-portion-picker" title={{{ [<hint-title>get[text]] }}}>
<$let state-title={{{ [[$:/state/hypergsd/portion/]addsuffix<currentTiddler>] }}}
  state-ref={{{ [[$:/state/hypergsd/portion/]addsuffix<currentTiddler>addsuffix[!!text]] }}}>
  <$select tiddler=<<state-title>> default={{{ [all[current]tags[]prefix<portion-prefix>first[]else<default-portion>] }}} actions="<$action-listops $tiddler=<<currentTiddler>> $tags='+[!prefix<portion-prefix>] [list<state-ref>] +[unique[]]'/>">
    <%if [<portion-bands>!match[no]] %><option value=<<top-portion>>>{{$:/language/hypergsd/Settings/PanelModal/PortionTop}}</option><%endif%>
    <$list filter="[<tag-list>] :and[tagging[]] :and[tags[]prefix<portion-prefix>!match<full-portion>!match<top-portion>] [<default-portion>] [<next-free-portion-tag>] +[unique[]removeprefix<portion-prefix>nsort[]addprefix<portion-prefix>]" variable="portion-option">
      <option value=<<portion-option>>><$text text={{{ [<portion-option>removeprefix<portion-prefix>] }}}/></option>
    </$list>
    <%if [<portion-bands>!match[no]] %><option value=<<full-portion>>>{{$:/language/hypergsd/Settings/PanelModal/PortionFull}}</option><%endif%>
  </$select>
</$let>
</span>
</$let>