title: $:/plugins/yan/hypergsd/ui/components/realm-selection

\whitespace trim
\procedure lingo-base() $:/language/hypergsd/Sidebar/

<!-- One config tiddler ($:/config/hypergsd/realm-selection — config, not state, so the selection persists) whose list field holds the entire selection: realm tag titles plus a `no-realm` sentinel when "Items not in a realm" is ticked. Every control is a membership toggle on that single list. Reads and writes both route through hgsd-realm-selection (the resolver every engine consumer uses), so a pristine missing tiddler renders every box ticked — the presentation the engine's all-realms scope already applies — and each toggle writes the EFFECTIVE selection plus or minus one box. Select none writes an EMPTY list — deliberately different from the pristine missing state that $hgsd.list treats as "everything". No JS anywhere. -->
<!-- The buster attribute fixes stale checkboxes: core's filter-mode <$checkbox> re-renders nothing on tiddler changes (attributes never change), so a membership change alters the buster -> refreshSelf() recreates the checkboxes -> checked states re-evaluate. -->
<!-- Writes use $filter (replace) rather than $subfilter (mutate): the new list is computed from the effective selection, which carries the pristine default, so every write is state-complete. [[no-realm]] stays double-bracketed as a safe literal mid-filter; [<realm>] transports the loop variable (filter-mode action strings resolve enclosing variables); +[unique[]] keeps re-ticks from duplicating entries. -->
<!-- The fieldset carries display:grid inline: each label takes its own row at native line-height, and \whitespace trim eats source-newline runs anyway. The &nbsp; inside each label is load-bearing. -->
<$refresh subfilter="[prefix[$:/GSD/Realm/]] [prefix[$:/state/hypergsd]] [prefix[$:/config/hypergsd]]"
  hgsd-realm-buster={{{ [[$:/config/hypergsd/realm-selection]get[list]else[pristine]] }}}>
<!-- The fieldset is semantic grouping: a labelled set of related form controls. -->
<fieldset class="hgsd-realm-fieldset" style="display:grid">
<legend><<lingo Review/SelectRealms>>
<$button class=<<tv-config-toolbar-class>> tooltip={{$:/language/hypergsd/Sidebar/Review/All/Hint}}
  actions="""<$action-listops $tiddler="$:/config/hypergsd/realm-selection" $field="list" $filter="[subfilter<hgsd-realm-all>]" />""">{{$:/language/hypergsd/Sidebar/Review/All}}</$button>
  &nbsp;
  <$button class=<<tv-config-toolbar-class>> tooltip={{$:/language/hypergsd/Sidebar/Review/None/Hint}}
  actions="""<$action-setfield $tiddler="$:/config/hypergsd/realm-selection" $field="list" $value="" />""">{{$:/language/hypergsd/Sidebar/Review/None}}</$button></legend>
<$checkbox
  filter="""[subfilter<hgsd-realm-selection>match[no-realm]]"""
  checkactions="""<$action-listops $tiddler="$:/config/hypergsd/realm-selection" $field="list" $filter="[subfilter<hgsd-realm-selection>] [[no-realm]] +[unique[]]" />"""
  uncheckactions="""<$action-listops $tiddler="$:/config/hypergsd/realm-selection" $field="list" $filter="[subfilter<hgsd-realm-selection>] -[[no-realm]]" />"""
>&nbsp;//<<lingo Review/NoRealm>>//</$checkbox>
<$list filter="[all[tags]prefix[$:/GSD/Realm/]sort[title]]" variable="realm">
  <$checkbox
    filter="""[subfilter<hgsd-realm-selection>match<realm>]"""
    checkactions="""<$action-listops $tiddler="$:/config/hypergsd/realm-selection" $field="list" $filter="[subfilter<hgsd-realm-selection>] [<realm>] +[unique[]]" />"""
    uncheckactions="""<$action-listops $tiddler="$:/config/hypergsd/realm-selection" $field="list" $filter="[subfilter<hgsd-realm-selection>] -[<realm>]" />"""
  >&nbsp;<$text text={{{ [<realm>removeprefix[$:/GSD/Realm/]] }}}/></$checkbox>
</$list>
</fieldset>
</$refresh>