title: $:/plugins/yan/hypergsd/ui/components/type-picker

\whitespace trim

<!-- The type tick row for Fragments rows (ui/components/fragment-item-template renders it on every row). One box per type in the vocabulary — the $:/tags/hypergsd/Type members' hgsd-type words, so Contacts, References and any extension type get boxes alongside Actions and Projects. On Row placements the boxes govern row items' types; on the Panel placement they govern link-TARGET types — the same config tiddlers either way. Each box is a PLAIN field checkbox on its own config tiddler, $:/config/hypergsd/Fragment/type-hide/<member>/<type> reading show/hide (absent = show): no action strings, no variables to transport through the actions hop, and native refresh — the checkbox re-renders itself when its tiddler changes. The engines (hgsd-item, hgsd-panel-items) gate on the same titles. The tiddler attribute is a render-time filtered transclusion, where variables resolve normally. -->
<$list filter="[[$:/tags/hypergsd/Type]] :and[tagging[]] :and[get[hgsd-type]]" variable="type-word">
  <$checkbox
    tiddler={{{ [[$:/config/hypergsd/Fragment/type-hide/]addsuffix<currentTiddler>addsuffix[/]addsuffix<type-word>] }}}
    field="text"
    checked="show"
    unchecked="hide"
    default="show">
    <span class="tc-tiny-gap-left"><$text text={{{ [<type-word>addsuffix[s]sentencecase[]] }}}/></span>
  </$checkbox>
</$list>
