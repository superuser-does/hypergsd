caption: {{$:/language/hypergsd/Sections/Realm/Caption}}
description: {{$:/language/hypergsd/Sections/Realm/Description}}
tags: $:/tags/hypergsd/ModalTemplate $:/tags/hypergsd/ModalTemplate/Portion/2
title: $:/plugins/yan/hypergsd/ui/modal/realm

\whitespace trim
\procedure lingo-base() $:/language/hypergsd/Sections/
\define hgsd-realm-pill(fallbackTarget, colourA, colourB)
<$let foregroundColor=<<contrastcolour target:"" fallbackTarget:"""$fallbackTarget$""" colourA:"""$colourA$""" colourB:"""$colourB$""">>>
<label><br /><br /><span class="tc-tag-label tc-btn-invisible" style=<<tag-pill-styles>>><span class="tc-tag-missing"><$text text="$:/GSD/Realm/" /></span><span class="tc-edit-field-add-name-wrapper"><$edit-text tiddler="$:/temp/gsd-new-realm-name" default="" tag="input" class="tc-edit-texteditor hgsd-tag-pill-input" size="10" placeholder={{$:/language/EditTemplate/Tags/Add/Placeholder}} /></span></span></label>
</$let>
\end

<label>
<<lingo Realm/Label>>
<br />
<$select tiddler="$:/state/hypergsd/effective-realm" default="">
  <option value=""><<lingo Realm/None>></option>
  <$list filter="[all[tags]prefix[$:/GSD/Realm/]removeprefix[$:/GSD/Realm/]sort[]]">
    <option value=<<currentTiddler>>><$view field="title" /></option>
  </$list>
  <option value="new"><<lingo Realm/New>></option>
</$select>
</label>
<!-- "New realm" flow: the typed name lives on a temp OUTSIDE every refresh-gate prefix (the $:/temp/gsd-new-title pattern — a $:/state/hypergsd title rides the gates' prefix runs, re-rendering the attribute chassis plus every open panel per keystroke); it is read once at submit and becomes $:/GSD/Realm/<name>. The <br /> pair lives INSIDE the pill's label, within the reveal gate, so nothing dangles when hidden — element interiors parse inline and \whitespace trim eats newline runs, so a newline cannot do the job, and a blank line BEFORE the gate is no better (a widget after a text paragraph always parses into a static wrapper paragraph that dangles empty when the gate closes, and the family prefers markup over an empty-paragraph CSS collapse, so the break pair approximates the paragraph gap). The select's label closes before the flow because a label names its FIRST labelable descendant only — the name input takes its own label around prefix + input, so the prefix is its accessible name and its click target. The pill is core's own rendering for a colourless missing tag — tc-tag-label chrome, tc-tag-missing prefix, ink TRANSCLUDED through core's contrastcolour over the live palette (the tag-pill-body textual-substitution shape; the class rule's tag-foreground is only a fallback ink, and Vanilla ships it white, wrong on the gold fill) — and the input rides core's editor-input chrome (tc-edit-texteditor inside the add-field row's tc-edit-field-add-name-wrapper, whose width:auto keeps a framed host's width:100% editor rule from stretching the pill), the class + size hooking the pill-input rule in stylesheet.tid. -->
<$list filter="[[$:/state/hypergsd/effective-realm]get[text]match[new]]">
<$let fallback-target={{{ [[$:/palette]get[text]getindex[tag-background]] }}}
      colour-a={{{ [[$:/palette]get[text]getindex[foreground]] }}}
      colour-b={{{ [[$:/palette]get[text]getindex[background]] }}}>
<$transclude $variable="hgsd-realm-pill" fallbackTarget=<<fallback-target>> colourA=<<colour-a>> colourB=<<colour-b>> />
<!-- Core's bad-character warning over the typed realm name (the name becomes the $:/GSD/Realm/<name> tag title at submit), the small icon form beside the pill — a one-line control takes a one-line warning, not the box; live-updates through the modal gate's gsd-new-realm-name prefix run. The entity carries the gap (element interiors parse inline and trim eats plain spaces). -->
&nbsp;<$transclude $variable="hgsd-title-warning" typed-value={{{ [[$:/temp/gsd-new-realm-name]get[text]] }}} />
</$let>
</$list>