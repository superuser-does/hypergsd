caption: {{$:/plugins/yan/hypergsd/images/action}} {{$:/language/hypergsd/Toolbar/NewAction/Caption}}
description: {{$:/language/hypergsd/Toolbar/NewAction/Description}}
tags: $:/tags/PageControls
title: $:/plugins/yan/hypergsd/ui/buttons/add-action-button

\whitespace trim
<$hgsd.new-button
    gsd-type="action"
    gsd-status="next"
    gsd-complete="false"
    tooltip={{$:/language/hypergsd/Toolbar/NewAction/Hint}}
    class={{{ [<tv-config-toolbar-class>] [<class>] +[join[ ]] }}} >
    <$list filter="[<tv-config-toolbar-icons>match[yes]]">
        {{$:/plugins/yan/hypergsd/images/action}}
    </$list>
    <$list filter="[<tv-config-toolbar-text>match[yes]]">
        <span class="tc-btn-text">{{$:/language/hypergsd/Toolbar/NewAction/Label}}</span>
    </$list>
</$hgsd.new-button>