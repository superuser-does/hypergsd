caption: {{$:/language/hypergsd/Settings/Fragments/ProjectLink/Caption}}
description: {{$:/language/hypergsd/Settings/Fragments/ProjectLink/Hint}}
tags: $:/tags/hypergsd/ListItem/Suffix
title: $:/plugins/yan/hypergsd/ui/list-items/project-link

\whitespace trim

<!-- Jump-to-project icon for any row whose item carries gsd_project (actions, sub-projects, references). The tooltip is the target tiddler's title. storyTiddler is snapshotted by the core ViewTemplate before any list loop redefines currentTiddler, so a match means the row renders inside the project's own page; current-group is ambient only in grouped lists (every shipped one groups by gsd_project or gsd_contact), so a match means the heading already links there. Both are unset in flat lists, where !match passes. -->
<%if [all[current]get[gsd_project]trim[]!is[blank]!match<storyTiddler>!match<current-group>] %>
<span>
    <$link to={{{ [all[current]get[gsd_project]trim[]] }}} tooltip={{{ [all[current]get[gsd_project]trim[]] }}} class="gsd-muted hgsd-project-link">
        <$transclude $tiddler="$:/plugins/yan/hypergsd/images/project" size="1em"/>
    </$link>
</span>
<%endif%>