caption: {{$:/language/hypergsd/Sections/Project/Caption}}
description: {{$:/language/hypergsd/Sections/Project/Description}}
tags: $:/tags/hypergsd/PanelTemplate $:/tags/hypergsd/PanelTemplate/Portion/1 $:/tags/hypergsd/ModalTemplate $:/tags/hypergsd/ModalTemplate/Portion/1
title: $:/plugins/yan/hypergsd/ui/attributes/project

\whitespace trim
\procedure lingo-base() $:/language/hypergsd/Sections/

<!-- One pick-field over section-target: the panel target is the open tiddler (immediate saves), the modal's is the data temp (drafting — submit copies; the inherited project arrives seeded on the temp by hgsd.new-button). Candidates exclude the target itself; the plain new-button fallback is suppressed in the modal (modals do not stack) while typed non-existent picks still offer create-and-add. -->
<%if [<section-type>match[action]] [<section-type>match[project]] [<section-type>match[reference]] %>
<div>
    <div>
        <%if [<section-type>match[project]] %><<lingo Project/SubLabel>><%else%><<lingo Project/OfLabel>><%endif%>
        <br/>
        <$hgsd.pick-field
            tiddler=<<section-target>>
            field="gsd_project"
            list-filter="[tag[$:/GSD/Project]gsd_complete[false]] -[<section-target>]"
            id="project"
            new-type="project"
            new-status="active"
            new-button={{{ [<section-mode>match[modal]then[hide]else[show]] }}}
    />
    </div>
</div>
<%endif%>