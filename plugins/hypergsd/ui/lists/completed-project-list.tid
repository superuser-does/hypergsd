caption: {{$:/language/hypergsd/Settings/Lists/CompletedProjects/Caption}}
description: {{$:/language/hypergsd/Settings/Lists/CompletedProjects/Hint}}
hgsd-heading: $:/language/hypergsd/Lists/CompletedProjects
tags: $:/tags/hypergsd/Lists/Dashboard $:/tags/hypergsd/Lists/Dashboard/Portion/Full $:/tags/hypergsd/Lists/Project $:/tags/hypergsd/Lists/Project/Portion/Full $:/tags/hypergsd/Lists/CompletedProject
title: $:/plugins/yan/hypergsd/ui/lists/completed-project-list

\whitespace trim

<!-- The list carries its own disclosure: on the Dashboard tag list it renders collapsed behind the toggle (an explicit state, <prefix>projects@<hosting page>, opening independently of the completed-actions list beside it — both members used to derive the same page state and open together; the page stays the title's suffix, the form the refresh gates scope on); the dedicated Completed Projects page renders it bare. -->
<$hgsd.toggle
  text={{$:/language/hypergsd/Lists/ShowCompletedLists}}
  hide-text={{$:/language/hypergsd/Lists/HideCompletedLists}}
  class="hgsd-completed-toggle"
  state={{{ [[$:/state/hypergsd/show-completed/projects@]addsuffix<currentTiddler>] }}}
  unwrap-tag-lists="$:/tags/hypergsd/Lists/CompletedProject">
<$hgsd.list
  list-heading={{$:/language/hypergsd/Lists/CompletedProjects}}
  list-filter="[tag[$:/GSD/Project]gsd_complete[true]]"
  group-select="yes"
  sort-select="yes"
  sort-default="$:/plugins/yan/hypergsd/ui/sort-by/completed-desc" />
</$hgsd.toggle>