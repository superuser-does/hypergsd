caption: {{$:/language/hypergsd/Settings/Lists/CleanupActions/Caption}}
description: {{$:/language/hypergsd/Settings/Lists/CleanupActions/Hint}}
hgsd-heading: $:/language/hypergsd/Lists/CompletedActions
tags: $:/tags/hypergsd/Lists/Cleanup
title: $:/plugins/yan/hypergsd/ui/lists/cleanup-actions

\whitespace trim

<!-- The first :filter run keeps completed actions whose project is complete or missing, else-admitting every dropped item while the config ($:/config/hypergsd/cleanup-uncompleted-project-actions, show/hide) says show (single-run chains only: multi-run subfilters do not parse inside suffix operands). The trailing :filter hides archived rows — $:/GSD/-prefixed renames, the cleanup page's archive button output — unless the page's show-archived checkbox ($:/config/hypergsd/cleanup-archived-items) swaps the prefix for a never-matching sentinel; archived-exclude-prefix and age-in-days/show-uncompleted-parent-items arrive ambiently from the cleanup page, the one host of this list. NO !is[system] in the leading run: the pipeline must let archived rows in so the conditional run is the sole gatekeeper. -->
<$hgsd.list
  list-heading={{$:/language/hypergsd/Lists/CompletedActions}}
  list-filter="[tag[$:/GSD/Action]gsd_complete[true]!days:gsd_comp_date<age-in-days>] :filter[get[gsd_project]get[gsd_complete]else[true]match[true]else<show-uncompleted-parent-items>match[true]] :filter[!prefix<archived-exclude-prefix>]"
  group-select="yes"
  sort-select="yes"
  sort-default="$:/plugins/yan/hypergsd/ui/sort-by/completed-desc"/>
