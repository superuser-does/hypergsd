caption: {{$:/language/hypergsd/Settings/Lists/CompletedActions/Caption}}
description: {{$:/language/hypergsd/Settings/Lists/CompletedActions/Hint}}
hgsd-heading: $:/language/hypergsd/Lists/CompletedActions
tags: $:/tags/hypergsd/Lists/Dashboard $:/tags/hypergsd/Lists/Dashboard/Portion/Full $:/tags/hypergsd/Lists/Action $:/tags/hypergsd/Lists/Action/Portion/Full $:/tags/hypergsd/Lists/CompletedAction
title: $:/plugins/yan/hypergsd/ui/lists/completed-action-list

\whitespace trim

<!-- The list carries its own disclosure: on the dashboard tag lists it renders collapsed behind the toggle (an explicit state, <prefix>actions@<hosting page>, so it opens independently of the completed-projects list beside it — both members used to derive the same page state and open together; the page stays the title's suffix, the form the refresh gates scope on); the dedicated Completed Actions page (whose entire content this member is) renders it bare. -->
<$hgsd.toggle
  text={{$:/language/hypergsd/Lists/ShowCompletedActions}}
  hide-text={{$:/language/hypergsd/Lists/HideCompletedActions}}
  class="hgsd-completed-toggle"
  state={{{ [[$:/state/hypergsd/show-completed/actions@]addsuffix<currentTiddler>] }}}
  unwrap-tag-lists="$:/tags/hypergsd/Lists/CompletedAction">
<!-- !is[system] in the leading run: archived rows ($:/GSD/-prefixed renames from the cleanup tab's archive button) keep their tags and completion fields, and the default filter source admits system titles (only shadows are excluded), so the run is load-bearing. -->
<$hgsd.list
  list-heading={{$:/language/hypergsd/Lists/CompletedActions}}
  list-filter="[tag[$:/GSD/Action]gsd_complete[true]!is[system]]"
  group-select="yes"
  sort-select="yes"
  sort-default="$:/plugins/yan/hypergsd/ui/sort-by/completed-desc"/> <!-- rows take their order from the strip (completed-desc sinks undated legacy items; ties fall to the default title order) -->
</$hgsd.toggle>