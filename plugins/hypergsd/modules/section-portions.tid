tags: $:/tags/Global
title: $:/plugins/yan/hypergsd/modules/section-portions

\whitespace trim

<!-- The ONE portion chassis core behind both named wrappers (panels/modal and dashboards): Portion/1..N render as side-by-side boxes (flattened to one flow by the panel-layout setting), while the two band slots bracket the row — Portion/Top spans the full width before it, Portion/Full after it. A portion exists the moment a member claims it; untagged members land in Portion/1 (the else<default-portion> indirection resolves their effective portion, so explicit and implicit claims share one loop and tag-list order rules within a portion); membership/order come from the tag's list field; visibility per member from <visibility-base><title>. Members are list tiddlers transcluded in block mode and read their section context (section-target/type/mode or new-data-title/current-type) from the CALLER's ambient scope. Scope: Global, not Global/View — the modal renders outside ViewTemplate imports. -->
\procedure hgsd-portions-core(tag-list, visibility-base, columns-class)
<$let default-portion={{{ [<tag-list>addsuffix[/Portion/1]] }}}
  portion-prefix={{{ [<tag-list>addsuffix[/Portion/]] }}}
  top-portion={{{ [<tag-list>addsuffix[/Portion/Top]] }}}
  full-portion={{{ [<tag-list>addsuffix[/Portion/Full]] }}} >
<%if [<tag-list>] :and[tagging[]] :and[tag<top-portion>limit[1]] %>
<div class="hgsd-portion-top">
  <$list filter="[<tag-list>] :and[tagging[]] :and[tag<top-portion>] :and[!is[draft]]" variable="portion-member">
    <%if [<visibility-base>addsuffix<portion-member>get[text]else[show]match[show]] %>
      <$transclude $tiddler=<<portion-member>> $mode="block"/>
    <%endif%>
  </$list>
</div>
<%endif%>
<div class=<<columns-class>>>
  <$list filter="[<tag-list>] :and[tagging[]] :and[tags[]prefix<portion-prefix>!match<full-portion>!match<top-portion>] [<default-portion>] +[unique[]] +[sort[]]" variable="capture-portion-tag">
    <div>
      <$list filter="[<tag-list>] :and[tagging[]] :and[!is[draft]] :filter[tags[]prefix<portion-prefix>first[]else<default-portion>match<capture-portion-tag>]" variable="portion-member">
        <%if [<visibility-base>addsuffix<portion-member>get[text]else[show]match[show]] %>
          <$transclude $tiddler=<<portion-member>> $mode="block"/>
        <%endif%>
      </$list>
    </div>
  </$list>
</div>
<%if [<tag-list>] :and[tagging[]] :and[tag<full-portion>limit[1]] %>
<div class="hgsd-portion-full">
  <$list filter="[<tag-list>] :and[tagging[]] :and[tag<full-portion>] :and[!is[draft]]" variable="portion-member">
    <%if [<visibility-base>addsuffix<portion-member>get[text]else[show]match[show]] %>
      <$transclude $tiddler=<<portion-member>> $mode="block"/>
    <%endif%>
  </$list>
</div>
<%endif%>
</$let>
\end

\procedure hgsd-section-portions(tag-list, visibility-base)
<$transclude $variable="hgsd-portions-core" tag-list=<<tag-list>> visibility-base=<<visibility-base>> columns-class="hgsd-capture"/>
\end

<!-- Dashboard pages' wrapper: same slot vocabulary, full-width row (dashboards fill the page; panels hug content in .hgsd-capture). Refresh gate: dashboard pages sit in the story with no chassis gate of their own, so portion/membership edits (Settings picker, tag-list `list` writes) and per-list visibility config must wake this row. Item edits and deletions open the chassis via the type-gate and !is[tiddler] runs so the inner $hgsd.list gates can decide for themselves (their rows freeze further down); drafts never match the type-gate, so editor keystrokes stay out. The [match<tag-list>] run is input-driven, not a bare [<tag-list>] variable run — a variable run emits the tag's title unconditionally, which kept this gate permanently open (fixed 2026-09-12). Two base runs admit content that lives INSIDE this gate: the config prefix (a member list's view strip reads its per-list config tiddler inside the list's own freeze below; also config-driven list options like future-items-sweep) and the scoped show-completed pair ($hgsd.toggle state inside a member's own content; subtraction scopes it to this page — a suffix-of-another-title page over-refreshes, never under-refreshes). Everything feature-owned is DERIVED (hgsd-chassis-whitelist, file top): ListItem fragments' and this tag list's members' hgsd-refresh-whitelist fields, plus Strip members found transitively through the members' hgsd-heading — a missed declaration, not a missed host-gate run, is the only way a member's control can freeze now. -->
<!-- Feature-run derivations for the chassis gates (hgsd-dashboard-portions and the view-body wrappers that host it): Lists members declare their own subtree's state prefixes in an hgsd-refresh-whitelist field; Strip members are found transitively — a member's hgsd-heading (a lingo title) resolves to the heading text its lists render under, and Strip members bind to heading text via hgsd-strip-host. The sentinel · keeps the anchored regex from compiling empty (an empty regexp matches everything) when no member carries hgsd-heading. -->
\function hgsd-member-feature-runs()
[<tag-list>] :and[tagging[]] :and[get[hgsd-refresh-whitelist]split[ ]] +[join[ ]]
\end

\function hgsd-chassis-strip-feature-runs()
[[$:/tags/hypergsd/Strip]] :and[tagging[]] :filter[get[hgsd-strip-host]else[]regexp<strip-hosts-regex>] :and[get[hgsd-refresh-whitelist]split[ ]] +[join[ ]]
\end

\function hgsd-chassis-whitelist(base-whitelist:"[subfilter<hgsd-type-gate>] [!is[tiddler]] [match<tag-list>] [tag<tag-list>] [prefix<visibility-base>] [prefix[$:/config/hypergsd]] [prefix[$:/state/hypergsd/show-completed/]] -[prefix[$:/state/hypergsd/show-completed/]!suffix<currentTiddler>]")
[function[hgsd-listitem-feature-runs]] [function[hgsd-member-feature-runs]] [function[hgsd-chassis-strip-feature-runs]] [<base-whitelist>] +[join[ ]]
\end

\procedure hgsd-dashboard-portions(tag-list, visibility-base)
<!-- The strip-hosts regex for the transitive derivation: this list's members' resolved heading texts. Sits above the gate (the derivation reads it as a variable), so it recomputes on every admitted descent — one tag-index walk, page-level, negligible. -->
<$let strip-hosts-regex={{{ [<tag-list>] :and[tagging[]] :and[get[hgsd-heading]get[text]] [[·]] +[join[|]addprefix[^(]addsuffix[)$]] }}}>
<$refresh subfilter={{{ [function[hgsd-chassis-whitelist]] }}} subfilter-tag-inputs={{{ [<tag-list>] [[$:/tags/hypergsd/ListItem/Prefix]] [[$:/tags/hypergsd/ListItem/Suffix]] [[$:/tags/hypergsd/Strip]] +[join[ ]] }}}>
<$transclude $variable="hgsd-portions-core" tag-list=<<tag-list>> visibility-base=<<visibility-base>> columns-class="hgsd-portion-columns"/>
</$refresh>
</$let>
\end