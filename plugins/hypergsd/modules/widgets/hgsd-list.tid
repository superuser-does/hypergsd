tags: $:/tags/Global/View
title: $:/plugins/yan/hypergsd/modules/widgets/hgsd-list

\whitespace trim

<!-- Scope: $:/tags/Global/View — every consumer renders inside a ViewTemplate (dashboards-in-story, view bodies, panels) — no modal/sidebar/chrome use. -->

<!-- ROW COMPOSITION: Prefix fragments, title link, Suffix fragments — the closed row pair of the Fragment root (ui/tags/hypergsd/Fragment/Row/*). The literal-input tag list form makes sortByList honour the tag tiddler's list field first and member list-before/list-after pins after (Suffix pins comp-date/note/realm/delete via the core-only list field; Prefix members self-pin — complete checkbox, status pills, then the priorities select). Fragments must self-gate and render with currentTiddler = the row item (plain transclusion inherits the caller's scope); unlisted ones append alphabetically. Visibility is per placement ($:/config/hypergsd/Fragment/Row/<placement>/visibility/<title>). Type suppression is engine-owned: a fragment hidden for a type via $:/config/hypergsd/Fragment/type-hide/<title>/<type> reading hide (absent = show) renders nowhere on those rows; the config prefix rides every gate, so box writes in Settings live-update. item-type is derived once per row above the loops and flows ambiently into fragments. -->
\procedure hgsd-item()
<!-- ROW FREEZE: one membership check at the row door — the whitelist is composed per list (hgsd-row-whitelist-expression, the file-top function, retrieved by hgsd-render-inner): the engine's base runs plus every row fragment's refresh-whitelist field, so a stateful fragment declares its own dependencies instead of the main plugin hardcoding them (the base's [match<currentTiddler>] is input-driven: a changed title passes only if it IS this row's item). An unrelated item edit stops here instead of descending the row's fragment tree. Membership (row added/removed) stays with the outer list patching. subfilter-tag-inputs caches the derivation (refresh.js): the two row tag lists' membership and member fields are its only tiddler inputs, so the subfilter re-derives only when those change — not per row per admitted pass. -->
<$refresh subfilter={{{ [function[hgsd-row-whitelist-expression]] }}} subfilter-tag-inputs="$:/tags/hypergsd/Fragment/Row/Prefix $:/tags/hypergsd/Fragment/Row/Suffix">
<$let item-type={{{ [all[current]tags[]] :filter[tag[$:/tags/hypergsd/Type]] :and[get[hgsd-type]] }}}>
<div class="gsd-list-item">
  <$list filter="[[$:/tags/hypergsd/Fragment/Row/Prefix]] :and[tagging[]]" variable="list-item">
    <%if [[$:/config/hypergsd/Fragment/Row/Prefix/visibility/]addsuffix<list-item>get[text]else[show]match[show]] %>
      <%if [[$:/config/hypergsd/Fragment/type-hide/]addsuffix<list-item>addsuffix[/]addsuffix<item-type>get[text]else[show]match[hide]] %>
        <!-- suppressed for this row type -->
      <%else%>
        <$transclude $tiddler=<<list-item>> />
      <%endif%>
    <%endif%>
  </$list>
  <$link class="gsd-list-item-title" to=<<currentTiddler>>><$view field="title"/></$link>
  <$list filter="[[$:/tags/hypergsd/Fragment/Row/Suffix]] :and[tagging[]]" variable="list-item">
    <%if [[$:/config/hypergsd/Fragment/Row/Suffix/visibility/]addsuffix<list-item>get[text]else[show]match[show]] %>
      <%if [[$:/config/hypergsd/Fragment/type-hide/]addsuffix<list-item>addsuffix[/]addsuffix<item-type>get[text]else[show]match[hide]] %>
        <!-- suppressed for this row type -->
      <%else%>
        <$transclude $tiddler=<<list-item>> />
      <%endif%>
    <%endif%>
  </$list>
  <!-- The realm globe is host-rendered infrastructure, not a fragment (ui/components/realm-warning): one indicator, one switch, no placement membership. -->
  <$transclude $variable="hgsd-realm-warning" linked-tiddler=<<currentTiddler>>/>
</div>
</$let>
</$refresh>
\end

<!-- Row-freeze whitelist derivation, the ONE source for both consumers: render-inner's per-list $let (inside the engine) and hgsd-item's refresh attribute (the view-body alias path outside it — without a default the alias rows' subfilter was undefined and refresh.js inhibited them permanently). A \function, not a procedure: the engine side must retrieve the JOINED STRING inside a filter expression, and [function[...]] is the sanctioned transport (an attribute-position macrocall of a procedure injects body markup, not its output). The base runs ride as the param DEFAULT: they stay unevaluated data until the $refresh subfilter runs with row scope (match<currentTiddler> is input-driven per row; run strings ending in ]] cannot be [[literals]]). -->
\function hgsd-row-whitelist-expression(base-whitelist:"[match<currentTiddler>] [prefix[$:/config/hypergsd]] [prefix[$:/tags/hypergsd/Fragment]] [tags[]prefix[$:/tags/hypergsd/Fragment]] -[is[draft]]")
[function[hgsd-row-feature-runs]] [<base-whitelist>] +[join[ ]]
\end

<!-- Feature-run derivations shared by every gate with fragments or strips below it. Contract: a stateful member carries its prefixes in an hgsd-refresh-whitelist field — space-separated single bracketed runs, no bare spaces inside (the same field the row freeze composes). hgsd-row-feature-runs unions the two row placements' members' runs (row-fragment state must pass every gate above the rows); link-family members are read-only adornments and keep state under gate-admitted prefixes instead. hgsd-strip-feature-runs adds the Strip members bound to THIS list (hgsd-strip-host = the heading text; hostless members render nowhere and stay out). The joined runs are literal data until the consuming gate's subfilter evaluates them over a change set. -->
\function hgsd-row-feature-runs()
[[$:/tags/hypergsd/Fragment/Row/Prefix]] [[$:/tags/hypergsd/Fragment/Row/Suffix]] :and[tagging[]] :and[get[hgsd-refresh-whitelist]split[ ]] +[join[ ]]
\end

\function hgsd-strip-feature-runs()
[[$:/tags/hypergsd/Strip]] :and[tagging[]] :filter[get[hgsd-strip-host]else[]match<list-heading>] :and[get[hgsd-refresh-whitelist]split[ ]] +[join[ ]]
\end

<!-- Gate compositions: base runs (engine-owned, unevaluated data until the subfilter runs) plus the derivations above; subfilter-tag-inputs fingerprints the three tag lists so the joined string re-derives only on membership or member-field changes. -->
\function hgsd-list-inner-whitelist(base-whitelist:"[subfilter<hgsd-type-gate>] [!is[tiddler]] [match<listState>] [prefix[$:/config/hypergsd]] [prefix[$:/tags/hypergsd/Fragment]] [tags[]prefix[$:/tags/hypergsd/Fragment]] -[is[draft]]")
[function[hgsd-row-feature-runs]] [function[hgsd-strip-feature-runs]] [<base-whitelist>] +[join[ ]]
\end

\function hgsd-list-outer-whitelist(base-whitelist:"[subfilter<hgsd-type-gate>] [tag[$:/tags/hypergsd/Type]] [prefix[$:/GSD/Realm/]] [prefix[$:/config/hypergsd]] [!is[tiddler]] -[is[draft]]")
[function[hgsd-row-feature-runs]] [function[hgsd-strip-feature-runs]] [<base-whitelist>] +[join[ ]]
\end

<!-- One grouping-strip radio. The label resolves via lingo with the raw key as fallback, so third-party members need no language tiddlers. Reads view-state-title from its invocation scope (render-inner). -->
\procedure hgsd-strip-radio(strip-member)
<$radio tiddler=<<view-state-title>> field="hgsd-group" value=<<strip-member>> default=<<effective-group-default>>>
  <span class="tc-tiny-gap-left"><$transclude $variable="hgsd-view-label" view-member=<<strip-member>> view-key-field="hgsd-group-key" view-lingo-base="$:/language/hypergsd/Lists/GroupBy/"/></span>
</$radio>
\end

<!-- Label for a tag-list member: the member's caption FIELD (a lingo transclusion — the core PageControls convention), rendered via field transclusion because get[caption] returns the raw {{…}} text. Fallback body: the member's key field (group-key / sort-key) resolved against <base>, for caption-less third-party members. -->
\procedure hgsd-view-label(view-member, view-key-field, view-lingo-base)
<$tiddler tiddler=<<view-member>>><$transclude field="caption"><$let view-key={{{ [<view-member>get<view-key-field>else<view-member>] }}} ><$text text={{{ [<view-lingo-base>addsuffix<view-key>get[text]else<view-key>] }}} /></$let></$transclude></$tiddler>
\end

<!-- Relevance guard for the Sort by option loops (the grouping strip derives its offered set as one filter instead — see the derivation below). Renders the caller's children only when the member declares no hgsd-types (universal) or one intersects the ambient list-types. A widget (not a procedure) because the children arrive via the slot. The $list-as- conditional shape is the proven one (:and with variable operands misfires; if-conditions cannot carry run prefixes). -->
\widget $hgsd.view-relevant(view-member)
<%if [<view-member>get[hgsd-types]else[]match[]] %>
  <$slot $name="ts-raw"/>
<%else%>
  <$let member-types={{{ [<view-member>get[hgsd-types]] }}} >
  <$list filter="[enlist<list-types>] :filter[enlist<member-types>match<currentTiddler>limit[1]]" variable="v-shared">
    <$slot $name="ts-raw"/>
  </$list>
  </$let>
<%endif%>
\end

<!-- The ONE grouped renderer (tag list strip and legacy group-by both feed it; the caller binds group-filter — a per-item filter emitting group key(s) as tiddler titles with currentTiddler = the item, evaluated via subfilter so variable operands like get<group-by> resolve — plus member-label-filter (optional heading display filter, currentTiddler = the group title; empty means the title) and show-ungrouped (yes/no)). Keys: the member filter emits per-item key(s); tag-based members emit several and such items rightly render under every group. Keyless items fall to the trailing No group container, gated as a whole and hidden when show-ungrouped is no. `current-group` stays ambient for the rows so ListItem fragments can suppress themselves under their own group heading. CONSTRAINT: the :map expressions must live in $list filter attributes — a triple-brace $let attribute holding a multi-item :map evaluates to EMPTY (single-item works, which makes it look fine in hand probes). The :and[unique[]sort[]] tail dedupes+orders the mapped keys (intersection with their own deduped set; a +[unique[]] append does NOT dedupe). COST: G groups × N items subfilter evaluations — fine at shipped list sizes, reconsider before pointing the strip at very large lists. -->
\procedure hgsd-render-grouped()
<$let hgsd-grouped="true">
  <$list filter="[enlist<hgsd-titles>] :map:flat[subfilter<group-filter>] :and[unique[]sort[title]!match[]]" variable="current-group">
    <div class="tc-menu-list-item hgsd-project-list">
      <div class="hgsd-group-title">
        <!-- Members with synthetic keys (not tiddler titles) declare hgsd-synthetic-keys — plain headings; everyone else links (missing-title keys are intentional: realm/project links navigate-create) -->
        <$let plain-heading={{{ [<effective-group>get[hgsd-synthetic-keys]else[no]match[yes]] }}}>
        <%if [<plain-heading>match[yes]] %>
          <$text text={{{ [<current-group>] :map[subfilter<member-label-filter>first[]else<current-group>] }}} />
        <%else%>
          <$link to=<<current-group>>><$text text={{{ [<current-group>] :map[subfilter<member-label-filter>first[]else<current-group>] }}} /></$link>
        <%endif%>
        </$let>
      </div>
      <$let loop-base="[enlist<hgsd-titles>] :filter[subfilter<group-filter>match<current-group>limit[1]]" rows-filter={{{ [<loop-base>] [<sort-expression>] +[join[ ]] }}} >
      <$list filter=<<rows-filter>>>
        <<hgsd-item>>
      </$list>
      </$let>
    </div>
  </$list>
  <%if [<show-ungrouped>!match[no]] %>
    <%if [enlist<hgsd-titles>] :filter[subfilter<group-filter>else[hgsd-keyless]match[hgsd-keyless]limit[1]] %>
    <div class="tc-menu-list-item hgsd-project-list">
      <div class="hgsd-group-title">{{$:/language/hypergsd/Lists/NoGroup}}</div>
      <$let loop-base="[enlist<hgsd-titles>] :filter[subfilter<group-filter>else[hgsd-keyless]match[hgsd-keyless]]" rows-filter={{{ [<loop-base>] [<sort-expression>] +[join[ ]] }}} >
      <$list filter=<<rows-filter>>>
        <<hgsd-item>>
      </$list>
      </$let>
    </div>
    <%endif%>
  <%endif%>
</$let>
\end

<!-- The ONE flat renderer: hgsd-grouped="false" lets row fragments supply the context the headings carry (the project-link icon, e.g.). -->
\procedure hgsd-render-flat()
<$let hgsd-grouped="false">
  <$let loop-base="[enlist<hgsd-titles>]" rows-filter={{{ [<loop-base>] [<sort-expression>] +[join[ ]] }}} >
  <$list filter=<<rows-filter>>>
    <<hgsd-item>>
  </$list>
  </$let>
</$let>
\end

\procedure hgsd-render-inner(hgsd-titles)
<$qualify title={{{ [[$:/temp/gsd-list/]addsuffix<currentTiddler>addsuffix[-]addsuffix<list-heading>] }}} name="listState">
<!-- ONE $let, attributes in dependency order — effective-group reads group-view-choice; LetWidget stages ordered attributes so later ones see earlier ones. -->
<$let group-view-choice={{{ [<view-state-title>get[hgsd-group]else[]] }}}
  effective-group={{{ [<group-view-choice>match[none]] [<group-view-choice>!match[none]addprefix[$:/config/hypergsd/GroupBy/hidden/]get[text]else[show]match[show]then<group-view-choice>] [<effective-group-default>addprefix[$:/config/hypergsd/GroupBy/hidden/]get[text]else[show]match[show]then<effective-group-default>] +[first[1]] }}}>
<!-- "none" is the None radio's SENTINEL VALUE: get[] on an existing-but-empty field emits nothing, so "" cannot distinguish an explicit None choice from no choice (a group-default then wrongly resurrected grouping). -->
<div class="tw-menu-list-item">
  <span class="gsd-list-heading">
    <$checkbox tiddler=<<listState>> field="text" checked="hide" unchecked="show" default="show">
      &nbsp;<<list-heading>>
      <$reveal state=<<listState>> type="match" text="hide" default="show" retain="yes">
        {{$:/core/images/chevron-down}}
      </$reveal>
    </$checkbox>
    <<add-button>>
  </span>
  <hr/>
  <$reveal state=<<listState>> type="match" text="show" default="show" retain="yes">
    <!-- Freezes this list against the global refresh cycle. No broad $:/state/hypergsd run: a changed hgsd-titles string busts the gate via hgsd-filter-buster, so a state run would only add cross-list amplification. Feature-owned state prefixes are DERIVED — the row fragments' and this heading's Strip members' hgsd-refresh-whitelist fields, composed by hgsd-list-inner-whitelist (file top) with the fingerprint cache on the three tag lists. The view strip below reads its config tiddler inside this gate — the config prefix run already carries those writes. -->
    <$refresh
      subfilter={{{ [function[hgsd-list-inner-whitelist]] }}}
      subfilter-tag-inputs="$:/tags/hypergsd/Fragment/Row/Prefix $:/tags/hypergsd/Fragment/Row/Suffix $:/tags/hypergsd/Strip"
      hgsd-group-buster=<<group-state>>
      hgsd-filter-buster=<<hgsd-titles>> >
    <!-- Performance note: Centralised O(1) event listener for all checkboxes and buttons in this list. -->
    <$eventcatcher selector=".hgsd-interactive input, .hgsd-interactive button" $click=<<hgsd-handle-click>> >

    <!-- ROW FREEZE WHITELIST, derived once per list via the file-top hgsd-row-whitelist-expression function (the engine base plus every ListItem member's refresh-whitelist field — each stateful fragment declares its own state deps there; runs must be single tokens / bracketed, no bare spaces inside). Derived inside this gate, so tag-list edits that change it re-render. -->
    <$let hgsd-row-whitelist={{{ [function[hgsd-row-whitelist-expression]] }}}>

    <!-- VIEW STRIP: any Strip members first (feature controls via the Strip tag list), then the Sort by select (sort-select), then the grouping radios (group-select) and the include-ungrouped checkbox. Every control writes a field on the one view-state tiddler natively. GROUPING: the offered set is derived once as offered-group-members (a titlelist string the radios iterate directly): `group-members` (a filter, evaluated here so run prefixes are legal) wins outright — type relevance is deliberately skipped so an explicit list can add a dimension the rules would hide; absent, the tag list minus Settings-hidden members minus type-irrelevant ones (no `hgsd-types` field = universal; declared types must intersect the list's own items' types — short names are word-like by convention, a regex metachar in one would mis-offer). An empty offered set withdraws the whole Group by block — label, leading None (empty value — also selected while the field is absent, i.e. flat), radios, ungrouped checkbox — because a None-only strip carries no choice; the strip row itself goes too unless the Sort by select keeps it. SORTING: an <optgroup> per distinct sort-category of the offered SortBy members (bare options for uncategorised members), option values are member titles; the relevance contract is identical. The type derivations and the offered-set chain sit INSIDE the row gate (above the choice gate): they re-run on view-state clicks via the config-prefix run, never on item edits. hgsd-group-default (the composition base for group-members) is the FULL tag list in render order — the tag-index enumeration behind the strip itself (list field, member pins, then alphabetical), so a composed set keeps pace with the shipped ordering — relevance applies only on the default path. Members unticked in Settings (config show/hide under $:/config/hypergsd/<Tag list>/hidden/) are excluded from every offered set here and in the Settings pickers; a view state or default naming one falls back — the choice chains take the view value if offered, else the default if offered, else nothing (grouping: empty renders flat, same as none; sorting: the list filter's own order); the hidden/ BASE tiddlers ship reading hide, so an empty candidate is withdrawn by construction. Explicit group-members lists are exempt (an author's explicit set is final). The choice chains test the hidden config only — a stored choice naming a type-irrelevant member still groups (rare; accepted rather than pay type derivations on item edits). Strip spacing: the row's flex gap between controls — the gap guarantees a space after every colon in every locale, so no hug rules, entities or spacer elements sit between strip children. Strip MEMBERS (the $:/tags/hypergsd/Strip tag list) render as the strip's leading children ahead of the Sort by label — see the STRIP MEMBERS comment below. -->
    <$let strip-members={{{ [[$:/tags/hypergsd/Strip]] :and[tagging[]] :filter[get[hgsd-strip-host]else[]match<list-heading>] +[format:titlelist[]join[ ]] }}}>
    <$let hgsd-group-default={{{ [[$:/tags/hypergsd/GroupBy]] :and[tagging[]] +[format:titlelist[]join[ ]] }}}>
    <$let list-types={{{ [enlist<hgsd-titles>tags[]unique[]tag[$:/tags/hypergsd/Type]get[hgsd-type]] }}}>
    <!-- Offered-set derivation feeding both the strip-withdrawal condition and the radio loop: emptiness must be checkable in one place so a None-only strip withdraws itself. The · alternative inside types-regex is what passes typeless (universal) members; get[]/enlist-input[] keep the relevance test input-driven, never relying on currentTiddler rebinding inside :filter. These derivations sit ABOVE the choice gate but INSIDE the row gate: the row gate's config-prefix run admits exactly the writes the buster did (view-state clicks), while item edits stay blocked — the re-derivation contract is unchanged. -->
    <$set name="offered-members-filter" value=<<group-members>> emptyValue="[[$:/tags/hypergsd/GroupBy]] :and[tagging[]] :filter[<currentTiddler>addprefix[$:/config/hypergsd/GroupBy/hidden/]get[text]else[show]match[show]] :filter[get[hgsd-types]else[·]enlist-input[]regexp<types-regex>]">
    <$let types-regex={{{ [enlist<list-types>] [[·]] +[join[|]addprefix[^(]addsuffix[)$]] }}}>
    <$let offered-group-members={{{ [subfilter<offered-members-filter>] :filter[<group-select>match[yes]] +[format:titlelist[]join[ ]] }}}>
    <%if [<sort-select>match[yes]] [<offered-group-members>!match[]] [<strip-members>!match[]] :and[limit[1]] %>
    <div class="hgsd-group-strip">
    <!-- STRIP MEMBERS (the $:/tags/hypergsd/Strip tag list): feature controls rendered as the strip's leading children, on the one list whose HEADING equals their hgsd-strip-host field — the heading is the engine's per-list identity (view-state and list-default key on it), and no title-based binding exists down here: the chassis transclusion does not rebind currentTiddler (core sets thisTiddler, which the variable-transclusion into this renderer clobbers), so heading text is the one stable token every caller carries (a list rendered on several surfaces collects its strip member on each). The operand-form match<list-heading> inside :filter resolves against the widget's parameter scope. Deliberately OUTSIDE the choice-buster gate below: that gate whitelists nothing (buster-only), so a member-hosted popup or reveal would freeze on its own state writes inside it. Consequently a strip member declares its state prefixes in an hgsd-refresh-whitelist field, and THIS gate's subfilter plus the chassis gates above derive them (hgsd-strip-feature-runs and the transitive chassis derivation — the Contacts picker is the shipped example). Membership follows plugin-refresh semantics (no gate runs for it). The lookup costs one tag-index probe per list render; ordering is the tag list's list field, then alphabetical. -->
    <$list filter="[[$:/tags/hypergsd/Strip]] :and[tagging[]] :filter[get[hgsd-strip-host]else[]match<list-heading>]" variable="strip-member">
      <$transclude $tiddler=<<strip-member>>/>
    </$list>
    <$refresh hgsd-choice-buster={{{ [<view-state-title>get[hgsd-group]else[]addsuffix[|]addsuffix[<view-state-title>get[hgsd-ungrouped]else[yes]]addsuffix[|]addsuffix[<view-state-title>get[hgsd-sort]else[]] }}} >
      <%if [<sort-select>match[yes]] %>
        <span class="gsd-muted">{{$:/language/hypergsd/Lists/SortBy}}</span>
        <$select tiddler=<<view-state-title>> field="hgsd-sort" default=<<effective-sort-member>>>
          <$list filter="[[$:/tags/hypergsd/SortBy]] :and[tagging[]] :filter[<currentTiddler>addprefix[$:/config/hypergsd/SortBy/hidden/]get[text]else[show]match[show]] :map:flat[get[hgsd-sort-category]] :and[unique[]sort[title]!match[]]" variable="sort-cat">
            <optgroup label={{{ [[$:/language/hypergsd/Lists/SortBy/Category/]addsuffix<sort-cat>get[text]else<sort-cat>] }}}>
              <$list filter="[[$:/tags/hypergsd/SortBy]] :and[tagging[]] :filter[get[hgsd-sort-category]match<sort-cat>] :filter[<currentTiddler>addprefix[$:/config/hypergsd/SortBy/hidden/]get[text]else[show]match[show]]" variable="sort-member">
                <$hgsd.view-relevant view-member=<<sort-member>>>
                  <option value=<<sort-member>>><$transclude $variable="hgsd-view-label" view-member=<<sort-member>> view-key-field="hgsd-sort-key" view-lingo-base="$:/language/hypergsd/Lists/SortBy/"/></option>
                </$hgsd.view-relevant>
              </$list>
            </optgroup>
          </$list>
          <$list filter="[[$:/tags/hypergsd/SortBy]] :and[tagging[]] :filter[get[hgsd-sort-category]else[·none·]match[·none·]] :filter[<currentTiddler>addprefix[$:/config/hypergsd/SortBy/hidden/]get[text]else[show]match[show]]" variable="sort-member">
            <$hgsd.view-relevant view-member=<<sort-member>>>
              <option value=<<sort-member>>><$transclude $variable="hgsd-view-label" view-member=<<sort-member>> view-key-field="hgsd-sort-key" view-lingo-base="$:/language/hypergsd/Lists/SortBy/"/></option>
            </$hgsd.view-relevant>
          </$list>
        </$select>
      <%endif%>
      <%if [<offered-group-members>!match[]] %>
        <span class="gsd-muted">{{$:/language/hypergsd/Lists/GroupBy}}</span>
        <$radio tiddler=<<view-state-title>> field="hgsd-group" value="none" default={{{ [<effective-group-default>match[]then[none]else<effective-group-default>] }}}>
          <span class="tc-tiny-gap-left">{{$:/language/hypergsd/Lists/GroupBy/None}}</span>
        </$radio>
        <$list filter="[enlist<offered-group-members>]" variable="group-member">
          <$transclude $variable="hgsd-strip-radio" strip-member=<<group-member>>/>
        </$list>
        <%if [<effective-group>!match[none]!match[]] %>
        <$checkbox
          filter="""[<view-state-title>get[hgsd-ungrouped]else[yes]match[yes]]"""
          checkactions="""<$action-setfield $tiddler=<<view-state-title>> $field="hgsd-ungrouped" $value="yes"/>"""
          uncheckactions="""<$action-setfield $tiddler=<<view-state-title>> $field="hgsd-ungrouped" $value="no"/>""">
          &nbsp;//{{$:/language/hypergsd/Lists/GroupBy/Ungrouped}}//
        </$checkbox>
        <%endif%>
      <%endif%>
    </$refresh>
    </div>
    <%endif%>
    </$let>
    </$let>
    </$set>
    </$let>
    </$let>
    </$let>

    <!-- Branch selection: the strip's chosen member (group-filter from the tag list, label-filter, ungrouped from the strip's toggle) or the legacy group-by field (subfilter resolves its variable operand; no label filter; No group always shown). group-select wins when both are passed. -->
    <%if [<group-select>match[yes]] %>
      <%if [<effective-group>!match[none]!match[]] %>
        <$let group-filter={{{ [<effective-group>get[hgsd-group-filter]else[]] }}}
          member-label-filter={{{ [<effective-group>get[hgsd-label-filter]else[]] }}}
          show-ungrouped={{{ [<view-state-title>get[hgsd-ungrouped]else[yes]] }}} >
        <<hgsd-render-grouped>>
        </$let>
      <%else%>
        <<hgsd-render-flat>>
      <%endif%>
    <%elseif [<group-state>match[false]] %> <!-- match[] is exact -->
      <<hgsd-render-flat>>
    <%elseif [<group-by>!match[]] %>
      <$let group-filter="[all[current]get<group-by>]"
        member-label-filter=""
        show-ungrouped="yes" >
      <<hgsd-render-grouped>>
      </$let>
    <%else%>
      <<hgsd-render-flat>>
    <%endif%>

    </$let>
    </$eventcatcher>
    </$refresh>
  </$reveal>
</div>
</$let>
</$qualify>
\end

\widget $hgsd.list(list-heading, list-filter, group-by, group-state, group-select:"no", group-members:"", sort-select:"no", sort-default:"$:/plugins/yan/hypergsd/ui/sort-by/modified-desc", group-default:"", add-button, future-items-sweep:"no", realm-scope:"[subfilter<hgsd-realm-selection>]")
<!-- realm-scope is an EVALUATED FILTER EXPRESSION whose output is the scope list (realm tags + the `no-realm` sentinel when realm-less items are included). Blank falls back to [subfilter<hgsd-realm-all>] (observably unscoped); any other value is evaluated as given — the same contract as $hgsd.pick. The set arithmetic lives in hgsd-scope-include/exclude (scope-base/scope-tags ambient). FUTURE-ITEMS-SWEEP: when "yes" and the config ($:/config/hypergsd/dashboard-future-project-items, show/hide) says hide, items are filtered to active-parent (parentless items always pass); the sweep run travels as string data through a quoted $let and joins into the rows filter (the sort-expression idiom — an empty sweep-run joins to a no-op), because brackets inside then[] operands terminate the operand. -->
<!-- OUTER DERIVATION GATE: without it the $let tree (list-filter evaluation + realm scope arithmetic) re-executed its filter-valued attributes on every global refresh descent (~0.3ms per item per list, paid on unrelated edits). The gate admits exactly what the derivation reads: item edits (type gate), realm tag-tiddlers, $:/config/hypergsd/*, and deletions — a deleted title has no tags, so only [!is[tiddler]] catches it. No realm-membership run: :and REPLACES the accumulated output (one :and chain per filter), and on GSD items the type gate already catches membership changes. Fragment and strip state prefixes arrive as DERIVED runs (hgsd-list-outer-whitelist, file top): this gate sits ABOVE the row freeze, so without them the members' state changes never reach it. The view strip's config tiddler rides the config prefix run the same way. -->
<!-- View state (persistent): one config tiddler per list instance carrying group (GroupBy member title), ungrouped (yes/no) and sort (SortBy member title). Persistent by design — each customised list gains one small tiddler under tiddlers/. The config prefix run below (already present) is all the gating these writes need at every level. group-default and sort-default are tag list TIDDLER TITLES (the same tokens the controls use as values and the state stores) applied while no choice exists — so the strip's displayed default IS the applied one. Precedence everywhere: view state, then the per-list default ($:/config/hypergsd/list-default/<heading> — the Settings pickers' write, keyed by the heading alone so one default serves every host the list renders on), then these parameters. A sort default missing its sort-filter sorts nothing (the list filter's own order). sort-expression empties when sort-select is off (then[] takes the lookup, else[] nothing — the renderers' join with an empty sort-expression is a no-op). The derivation $let below is ONE widget, its attributes in dependency order — LetWidget stages ordered attributes so each reads the earlier ones. -->
<$let view-state-title={{{ [[$:/config/hypergsd/list-view/]addsuffix<currentTiddler>addsuffix[/]addsuffix<list-heading>] }}}
  list-default-heading={{{ [[$:/config/hypergsd/list-default/]addsuffix<list-heading>] }}}
  effective-sort-default={{{ [<list-default-heading>get[hgsd-sort]else<sort-default>] }}}
  effective-group-default={{{ [<list-default-heading>get[hgsd-group]else<group-default>] }}}
  sort-view-choice={{{ [<view-state-title>get[hgsd-sort]else[]] }}}
  effective-sort-member={{{ [<sort-view-choice>addprefix[$:/config/hypergsd/SortBy/hidden/]get[text]else[show]match[show]then<sort-view-choice>] [<effective-sort-default>addprefix[$:/config/hypergsd/SortBy/hidden/]get[text]else[show]match[show]then<effective-sort-default>] +[first[1]] }}}
  sort-lookup={{{ [<effective-sort-member>get[hgsd-sort-filter]else[]] }}}
  sort-expression={{{ [<sort-select>match[yes]then<sort-lookup>else[]] }}}>
<$refresh subfilter={{{ [function[hgsd-list-outer-whitelist]] }}} subfilter-tag-inputs="$:/tags/hypergsd/Fragment/Row/Prefix $:/tags/hypergsd/Fragment/Row/Suffix $:/tags/hypergsd/Strip">
<!-- all-titles is the single draft gate: drafts inherit the base tiddler's fields and tags, so every list-filter would otherwise match them mid-edit. Inline on the candidates only — a per-list -[is[draft]] run sweeps the whole wiki per evaluation. -->
<$let future-items-visibility={{{ [[$:/config/hypergsd/dashboard-future-project-items]get[text]else[hide]] }}}
  all-titles={{{ [subfilter<list-filter>!is[draft]format:titlelist[]join[ ]] }}}>

  <$set name=realm-scope-filter value=<<realm-scope>> emptyValue="[subfilter<hgsd-realm-all>]">
  <!-- ONE derivation: the sentinel picks the scope arithmetic, the sweep gate picks the optional active-parent run — both resolved as strings (angle-form then<var> transports filter text wholesale) and joined into the rows filter, the composition the renderers' sort-expression already uses -->
  <$let scope-list={{{ [subfilter<realm-scope-filter>] +[format:titlelist[]join[ ]] }}}
    scope-base=<<all-titles>>
    scope-tags={{{ [enlist<scope-list>!match[no-realm]format:titlelist[]join[ ]] }}}
    sweep-guarded=":filter[get[gsd_project]get[gsd_status]else[active]match[active]]"
    sweep-run={{{ [<future-items-sweep>match[yes]then<sweep-guarded>] :filter[<future-items-visibility>match[hide]] }}}
    scope-include-run="[subfilter<hgsd-scope-include>]"
    scope-exclude-run="[subfilter<hgsd-scope-exclude>]"
    rows-filter={{{ [enlist<scope-list>match[no-realm]then<scope-include-run>else<scope-exclude-run>] [<sweep-run>] +[join[ ]] }}}
    hgsd-titles={{{ [subfilter<rows-filter>] +[format:titlelist[]join[ ]] }}} >
    <$transclude $variable="hgsd-render-inner" hgsd-titles=<<hgsd-titles>> />
  </$let>
  </$set>

</$let>
</$refresh>
</$let>
\end