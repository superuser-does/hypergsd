tags: $:/tags/Global/View
title: $:/plugins/yan/hypergsd/modules/widgets/hgsd-toggle

\whitespace trim

<!-- A disclosure wrapper: children render behind a show/hide button pair (the standard reveal idiom, packaged so laziness can live inside a tag-list member — the chassis that transcludes the member stays dumb to it). The default state namespace is the one the dashboard chassis gate admits (docs/refresh-gates.tid): overriding state-prefix inside a frozen surface means adding matching gate runs yourself. Default state is per hosting page (<currentTiddler> at transclusion time), so members sharing the default toggle together on that page; unwrap-tag-lists names tag lists where children render bare (the dedicated Completed pages list these very members as their entire content) — the ambient tag-list variable reaches the member through the chassis's plain transclusion. -->
\widget $hgsd.toggle(text, hide-text, state:"", state-prefix:"$:/state/hypergsd/show-completed/", class:"", unwrap-tag-lists:"")
<%if [enlist<unwrap-tag-lists>match<tag-list>limit[1]] %>
<$slot $name="ts-raw"/>
<%else%>
<$let derived-state={{{ [<state-prefix>addsuffix<currentTiddler>] }}} >
<$let toggle-state={{{ [<state>!match[]then<state>else<derived-state>] }}}
    open-label={{{ [<hide-text>!match[]then<hide-text>else<text>] }}} >
<$reveal state=<<toggle-state>> type="nomatch" text="show">
    <$button set=<<toggle-state>> setTo="show" class={{{ [<class>addsuffix[ hgsd-toggle hgsd-toggle-closed]trim[]] }}}>
        <<text>>
    </$button>
</$reveal>
<$reveal state=<<toggle-state>> type="match" text="show">
    <$button set=<<toggle-state>> setTo="hide" class={{{ [<class>addsuffix[ hgsd-toggle hgsd-toggle-open]trim[]] }}}>
        <<open-label>>
    </$button>
    <$slot $name="ts-raw"/>
</$reveal>
</$let>
</$let>
<%endif%>
\end