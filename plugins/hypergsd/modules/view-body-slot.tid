tags: $:/tags/Global/View
title: $:/plugins/yan/hypergsd/modules/view-body-slot

\whitespace trim

<!-- Tag list-driven placement: each $:/tags/hypergsd/ViewPlacement member owns one GSD type's view placement (fields per the tag tiddler's contract). This hook names no plugin — sub-plugin panels arrive here as members, so an absent sub-plugin is simply a shorter tag list. The two ViewTemplate wrappers pick their half of the body via the side param. -->

\procedure hgsd-view-body-slot(side)
<!-- Refresh gate: without it every open page re-evaluated every placement member's type condition and side/config derivations on every global cycle (typing anywhere = pages × members × filters). The admission set is the panel gate's proven set (type-gate, state/config/popup/temp prefixes, ListItem runs, drafts out) plus what this slot uniquely reads (ViewPlacement tag/prefix runs) and what lives BELOW it: the add-context temp is the contexts row fragment's pick temp — its suffix is a row id, not the host title, so the scoped add- pair cannot catch it; deletions must pass because the chassis/list machinery below catches removed rows only via !is[tiddler]. -->
<$refresh subfilter="[prefix[$:/temp/hypergsd/add-]] :and[suffix<currentTiddler>] [prefix[$:/temp/hypergsd/add-context-]] [subfilter<hgsd-type-gate>] [tag[$:/tags/hypergsd/ViewPlacement]] [prefix[$:/tags/hypergsd/ViewPlacement]] [tag[$:/tags/hypergsd/Type]] [prefix[$:/state/hypergsd]] [prefix[$:/temp/gsd-list]] [prefix[$:/state/popup/pick-]] [prefix[$:/config/hypergsd]] [prefix[$:/tags/hypergsd/ListItem]] [tags[]prefix[$:/tags/hypergsd/ListItem]] [!is[tiddler]] -[is[draft]]">
<$list filter="[all[shadows+tiddlers]tag[$:/tags/hypergsd/ViewPlacement]]" variable="position-member">
<$let member-config={{{ [<position-member>get[hgsd-config]addprefix[$:/config/hypergsd/Placement/]] }}}
  member-default={{{ [<position-member>get[hgsd-default]] }}}
  member-side={{{ [<member-config>get[text]else<member-default>] }}}
  member-type={{{ [<position-member>get[hgsd-type-tag]] }}} }>
<%if [is[current]tag<member-type>] %>
<%if [<member-side>match<side>] %>
<$list filter="[list<position-member>]" variable="position-body"><$transclude $tiddler=<<position-body>> $mode="block"/></$list>
<%endif%>
<%endif%>
</$let>
</$list>
</$refresh>
\end