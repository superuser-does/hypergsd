tags: $:/tags/Global
title: $:/plugins/yan/hypergsd/modules/create-and-add

\whitespace trim

<!-- Shared "create «typed» and add" cluster, split 2026-09-27 into a creation core plus the button shell so the pick family's keyboard-commit dispatcher (hgsd-pick-keyboard-commit, in hgsd-pick.tid) can run the SAME creation from a keyboard actions string. hgsd-create-and-add-actions is the core: creates the tiddler immediately (type tag via the tag-list mapping, realm tags inherited from currentTiddler so scoped pickers list it), writes the created title to target-tiddler/target-field, clears pick-tiddler/close-state when passed. The dependants shape passes target-field blank with new-prereq instead: nothing is written to a target; the created action's gsd_prerequisites gains new-prereq, and target-tiddler still names the caller for the AfterCreation rules. Every dynamic attribute in the core is a filtered transclusion: through the actions-string hop (the keyboard caller) a macro-style <<param>> attribute never fires the action widget, while filter expressions resolve the parameters reliably — the hgsd-pick-commit discovery; the button path is indifferent to the form. The shell keeps the label as a SLOT (default English) so fills render in the caller's scope where typed-pick is already computed. Callers gate on [<typed-pick>!match[]] :and[!is[tiddler]] — the variable run keeps multi-word titles whole (enlist<> splits them on spaces and would wrongly offer create for existing multi-word titles). Since 2026-10-26 the core also navigates after the hook: actions/projects honour the new-action-navigate / new-project-navigate toggles (same fallbacks as the modal), every other type keeps the picker's stay-in-place default. The kind-mapped contextual writes live in hgsd-link-created, shared with the AfterCreation panel-link rule so the picker and modal paths cannot drift. -->
<!-- The two derivations every creation path shares live here (the modal's create-gsd-tiddler calls both): the type-tag lookup and the core-field seeding gate — only action and project types carry gsd_status/gsd_complete at creation. -->
\function hgsd-type-tag(type) [all[shadows+tiddlers]tag[$:/tags/hypergsd/Type]] :filter[get[hgsd-type]match<type>] +[first[]]

\procedure hgsd-seed-core-fields(create-title, seed-type, seed-status, seed-complete)
<%if [<seed-type>match[action]] [<seed-type>match[project]] %>
  <$action-setfield $tiddler={{{ [<create-title>] }}} gsd_status={{{ [<seed-status>] }}} gsd_complete={{{ [<seed-complete>] }}} />
<%endif%>
\end

\procedure hgsd-link-created(created-title, link-target, link-field, link-kind)
<!-- The kind-mapped contextual write both creation paths share (the picker core below and the AfterCreation panel-link rule for modal creations): "field" sets link-target's field to the created title; "own" appends the created title to link-target's list field; "item" appends link-target to the CREATED tiddler's list field (the dependants mirror). The subfilters stay unevaluated so they run inside $action-listops at invoke time, where each single output becomes one quoted operand; evaluating early would splice a bare multi-word title into the filter text. -->
<%if [<link-kind>match[own]] %>
  <$action-listops $tiddler={{{ [<link-target>] }}} $field={{{ [<link-field>] }}} $subfilter="[<created-title>]"/>
<%elseif [<link-kind>match[item]] %>
  <$action-listops $tiddler={{{ [<created-title>] }}} $field={{{ [<link-field>] }}} $subfilter="[<link-target>]"/>
<%elseif [<link-kind>match[field]] %>
  <$action-setfield $tiddler={{{ [<link-target>] }}} $field={{{ [<link-field>] }}} $value={{{ [<created-title>] }}}/>
<%endif%>
\end

\procedure hgsd-create-and-add-actions(typed-pick, new-type, new-status, target-tiddler, target-field:"", pick-tiddler:"", pick-field:"pick", close-state:"", new-project:"", target-mode:"set", new-prereq:"")
<$let type-tag={{{ [function[hgsd-type-tag],<new-type>] }}} >
<$let new-tags={{{ [<currentTiddler>tags[]prefix[$:/GSD/Realm/]] [<type-tag>]
  +[format:titlelist[]join[ ]] }}}>
<!-- The tag-list filter runs BEFORE the concatenation: applied to the joined list it would drop the realm tags (they carry no hgsd-type field). -->
<$action-createtiddler $basetitle={{{ [<typed-pick>] }}} tags={{{ [<new-tags>] }}} >
  <!-- Follow-up actions nest inside $action-createtiddler: it publishes createTiddler-title only on its own subtree at invoke time (the invokeActions propagation walk refreshes each child action before firing it, so the filter forms below resolve the variable then). -->
  <$transclude $variable="hgsd-seed-core-fields" create-title={{{ [<createTiddler-title>] }}} seed-type={{{ [<new-type>] }}} seed-status={{{ [<new-status>] }}} seed-complete="false"/>
  <%if [<new-project>!match[]] %>
    <$action-setfield $tiddler={{{ [<createTiddler-title>] }}} gsd_project={{{ [<new-project>] }}}/>
  <%endif%>
  <%if [<new-prereq>!match[]] %>
    <!-- Dependants pickers: the created action depends on this title -->
    <$transclude $variable="hgsd-link-created" created-title={{{ [<createTiddler-title>] }}} link-target={{{ [<new-prereq>] }}} link-field="gsd_prerequisites" link-kind="item"/>
  <%endif%>
  <%if [<target-field>!match[]] %>
    <$transclude $variable="hgsd-link-created" created-title={{{ [<createTiddler-title>] }}} link-target={{{ [<target-tiddler>] }}} link-field={{{ [<target-field>] }}} link-kind={{{ [<target-mode>match[append]then[own]else[field]] }}} />
  <%endif%>
  <%if [<pick-tiddler>!match[]] %>
    <$action-setfield $tiddler={{{ [<pick-tiddler>] }}} $field={{{ [<pick-field>] }}} $value=""/>
  <%endif%>
  <%if [<close-state>!match[]] %>
    <$action-setfield $tiddler={{{ [<close-state>] }}} $field="text" $value=""/>
  <%endif%>
  <!-- AfterCreation rules run for picker creations too (new-source="picker"; navigate self-suppresses). Nested so createTiddler-title is in scope. -->
  <$transclude $variable="hgsd-run-after-create" new-title={{{ [<createTiddler-title>] }}} new-type={{{ [<new-type>] }}} calling-tiddler={{{ [<target-tiddler>] }}} new-source="picker" />
  <!-- Navigation, LAST and after the hook (the modal's type rule, extended to pickers 2026-10-26): actions honour new-action-navigate, projects new-project-navigate — every other type keeps the picker's stay-in-place behaviour (their field-add is the point). Same get[else[yes]] fallbacks as the modal; last so nothing after it can be cut short by the story changing. -->
  <%if [<new-type>match[action]] %>
    <%if [[$:/config/hypergsd/new-action-navigate]get[text]else[yes]match[yes]] %>
      <$action-navigate $to={{{ [<createTiddler-title>] }}} />
    <%endif%>
  <%elseif [<new-type>match[project]] %>
    <%if [[$:/config/hypergsd/new-project-navigate]get[text]else[yes]match[yes]] %>
      <$action-navigate $to={{{ [<createTiddler-title>] }}} />
    <%endif%>
  <%endif%>
</$action-createtiddler>
</$let>
</$let>
\end

\procedure hgsd-create-and-add(typed-pick, new-type, new-status, target-tiddler, target-field:"", pick-tiddler:"", pick-field:"pick", close-state:"", tooltip:"", new-project:"", target-mode:"set", new-prereq:"")
<$let hint-a-text={{{ [<close-state>!match[]then[$:/language/hypergsd/Widgets/CreateChange/HintA]else[$:/language/hypergsd/Widgets/CreateAdd/HintA]] :map[get[text]] }}}
  hint-b-text={{{ [<close-state>!match[]then[$:/language/hypergsd/Widgets/CreateChange/HintB]else[$:/language/hypergsd/Widgets/CreateAdd/HintB]] :map[get[text]] }}}>
<!-- The editing state passes close-state, and its commit REPLACES the field's value, so the button reads "create «typed» and change"; the empty state and list rows (no close-state) keep "and add". The fallback branch's else operand is the VARIABLE TITLE RUN, never enlist<> — enlist splits the unquoted prose sandwich into words and in attribute position only the first word survives the filtered transclusion (every shipped caller passes tooltip, so the fallback path rode unexercised until a caller relied on it). -->
<$let fallback-tooltip={{{ [<hint-a-text>] +[addsuffix[ ]] +[addsuffix<typed-pick>] +[addsuffix[ ]] +[addsuffix<hint-b-text>] }}}
  btn-tooltip={{{ [<tooltip>!match[]] :else[<fallback-tooltip>] }}}>
<$button tooltip=<<btn-tooltip>>>
  <$transclude $variable="hgsd-create-and-add-actions" typed-pick=<<typed-pick>> new-type=<<new-type>> new-status=<<new-status>> target-tiddler=<<target-tiddler>> target-field=<<target-field>> pick-tiddler=<<pick-tiddler>> pick-field=<<pick-field>> close-state=<<close-state>> new-project=<<new-project>> target-mode=<<target-mode>> new-prereq=<<new-prereq>>/>
  <%if [<close-state>!match[]] %>
  <$slot $name="label">{{$:/language/hypergsd/Widgets/CreateChange/LabelA}}<q><$text text=<<typed-pick>>/></q>{{$:/language/hypergsd/Widgets/CreateChange/LabelB}}</$slot>
  <%else%>
  <$slot $name="label">{{$:/language/hypergsd/Widgets/CreateAdd/LabelA}}<q><$text text=<<typed-pick>>/></q>{{$:/language/hypergsd/Widgets/CreateAdd/LabelB}}</$slot>
  <%endif%>
</$button>
<!-- Core's bad-character warning rides the shared shell itself, not per call site: every button-path typed creation (pick-field both states, pick-append rows, direct shell callers such as sub-plugin row fragments, the modal's pickers — and any future surface transcluding this shell) inherits the indicator with zero wiring. The entity carries the gap in inline-flow hosts (pick-append's and the direct callers' cluster divs; flex-row hosts add their own gap on top). The keyboard fork routes through hgsd-create-and-add-actions at keypress and never renders here — the row's create branch has already shown the icon on the same typed pick. -->
&nbsp;<$transclude $variable="hgsd-title-warning" typed-value={{{ [<typed-pick>] }}} />
</$let>
</$let>
\end