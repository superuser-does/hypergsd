caption: {{$:/language/hypergsd/Settings/Lists/Ticklers/Requiring/Caption}}
description: {{$:/language/hypergsd/Settings/Lists/Ticklers/Requiring/Hint}}
hgsd-heading: $:/language/hypergsd/Lists/Ticklers/Requiring
list-before:
tags: $:/tags/hypergsd/Lists/Dashboard $:/tags/hypergsd/Lists/Dashboard/Portion/Top $:/tags/hypergsd/Lists/Ticklers $:/tags/hypergsd/Lists/Ticklers/Portion/Top
title: $:/plugins/yan/hypergsd-ticklers/ui/lists/requiring-action-list

\whitespace trim

<!-- The empty list-before value is the pin: position zero in the engine's pin pass, ahead of every list-field anchor on both tag lists, so the list tops the Ticklers page and the main dashboard without touching either tag tiddler's list field. -->
<!-- The Portion/Top claims render it full width above each page's columns — the headline position; the pin keeps it first within the band and first in any column a later portion move drops it into. -->
<!-- A Settings drag deletes the field, handing placement to the user's written order — the pin is a default, not a lock. -->
<!-- Today derives per member; the 17-digit UTC strings compare correctly as strings (the tickler-check idiom). -->
<$let today=<<now "[UTC]YYYY0MM0DD000000000">>>
<$hgsd.list
  list-heading={{$:/language/hypergsd/Lists/Ticklers/Requiring}}
  list-filter="[tag[$:/GSD/Action]has[gsd_tickler_date]gsd_complete[false]] :filter[get[gsd_tickler_date]compare:string:lteq<today>] +[sort[gsd_tickler_date]]"
  group-select="yes"/>
</$let>